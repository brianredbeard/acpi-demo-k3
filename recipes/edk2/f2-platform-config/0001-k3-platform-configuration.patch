diff --git a/tools/tests/platform_config_host.c b/tools/tests/platform_config_host.c
new file mode 100644
index 00000000..c8a0ffe6
--- /dev/null
+++ b/tools/tests/platform_config_host.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <TestUefi.h>
+#include <uchar.h>
+
+typedef uint16_t CHAR16;
+typedef uint16_t UINT16;
+typedef uint8_t BOOLEAN;
+#define CONST const
+#define EFI_INVALID_PARAMETER 2
+#undef EFI_BUFFER_TOO_SMALL
+#define EFI_BUFFER_TOO_SMALL 5
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define CopyMem memcpy
+#define OFFSET_OF offsetof
+#define PcdGet8(pcd) (pcd)
+#define PcdGet64(pcd) (pcd)
+#define FixedPcdGet8(pcd) (pcd)
+#define PcdGetPtr(pcd) (&pcd)
+#define PcdGetSize(pcd) sizeof(pcd)
+
+#include "UsbHcdInitDxe/UsbHostPcdConfig.h"
+
+static USB_HOST_CONTROLLER_HW_ARRAY PcdUsbHostControllers;
+static UINT8 PcdUsbHostEnableMask, PcdUsbHostHsOnlyMask;
+static UINT8 PcdPcieHostEnableMask, PcdGmacUseMask, PcdK3ConfigDescriptionMode;
+static UINT64 PcdUfsAclkRate;
+static CHAR16 PcdFirmwareVersionString[] = u"1.2.3";
+static UINTN Sku;
+
+#include "K3PlatformConfigDxe.c"
+
+EFI_GUID gK3PlatformConfigProtocolGuid;
+static K3_PLATFORM_CONFIG_PROTOCOL *Published;
+
+static EFI_STATUS Install(EFI_HANDLE *handle, EFI_GUID *guid, int type, VOID *interface) {
+  assert(guid == &gK3PlatformConfigProtocolGuid && type == EFI_NATIVE_INTERFACE);
+  Published = interface;
+  return EFI_SUCCESS;
+}
+
+static EFI_BOOT_SERVICES Boot = { .InstallProtocolInterface = Install };
+EFI_BOOT_SERVICES *gBS = &Boot;
+UINTN LibPcdGetSku(void) { return Sku; }
+
+int main(void) {
+  K3_PLATFORM_CONFIG_SNAPSHOT s;
+
+  PcdUsbHostControllers.Num = 3;
+  PcdUsbHostControllers.Controller[0].MaxSpeed = USB_SPEED_SUPER;
+  PcdUsbHostControllers.Controller[1].MaxSpeed = USB_SPEED_HIGH;
+  PcdUsbHostControllers.Controller[2].MaxSpeed = 77; // unrecognized default
+  PcdUsbHostEnableMask = 0xff; // all described controllers, never all eight bits
+  PcdUsbHostHsOnlyMask = 1;
+  PcdK3ConfigDescriptionMode = 1;
+  PcdGmacUseMask = 2;
+  PcdPcieHostEnableMask = 9;
+  PcdUfsAclkRate = 491520000;
+  Sku = 243; // unrecognized SKU must retain its identity
+  assert(K3PlatformConfigEntry(NULL, NULL) == EFI_SUCCESS);
+  assert(Published->GetSnapshot(NULL, sizeof(s)) == EFI_INVALID_PARAMETER);
+  assert(Published->GetSnapshot(&s, sizeof(s)-1) == EFI_BUFFER_TOO_SMALL);
+  PcdUsbHostEnableMask = 0;
+  assert(Published->GetSnapshot(&s, sizeof(s)) == EFI_SUCCESS);
+  assert(s.Revision == 1 && s.Size == sizeof(s) && s.Generation == 1);
+  assert(s.Sku == 243 && s.UsbEnableMask == 0xff && s.UsbCount == 3);
+  assert(s.UsbState[0] == K3_USB_HIGH && s.UsbState[1] == K3_USB_HIGH);
+  assert(s.UsbState[2] == K3_USB_UNKNOWN);
+  assert(s.GmacMask == 2 && s.PcieMask == 9 && s.UfsAclkHz == 491520000);
+  assert(s.DescriptionMode == 1 && !memcmp(s.FirmwareVersion, u"1.2.3", sizeof(u"1.2.3")));
+  s.Sku = 0;
+  assert(Published->GetSnapshot(&s, sizeof(s)) == EFI_SUCCESS && s.Sku == 243);
+
+  PcdUsbHostEnableMask = 1;
+  PcdUsbHostHsOnlyMask = 0;
+  assert(K3PlatformConfigEntry(NULL, NULL) == EFI_SUCCESS);
+  assert(Published->GetSnapshot(&s, sizeof(s)) == EFI_SUCCESS);
+  assert(s.UsbState[0] == K3_USB_SUPER && s.UsbState[1] == K3_USB_OFF);
+
+  PcdUsbHostControllers.Num = USB_HOST_MAX_CONTROLLERS + 1;
+  assert(K3PlatformConfigEntry(NULL, NULL) == EFI_SUCCESS);
+  assert(Published->GetSnapshot(&s, sizeof(s)) == EFI_SUCCESS && s.UsbCount == 0);
+  return 0;
+}
diff --git a/tools/tests/test_platform_config.py b/tools/tests/test_platform_config.py
new file mode 100644
index 00000000..fd04f1fc
--- /dev/null
+++ b/tools/tests/test_platform_config.py
@@ -0,0 +1,27 @@
+"""Exercise the snapshot producer with boot services and PCD inputs supplied by the test."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+K3 = ROOT / 'Silicon/Spacemit/K3'
+HOST = K3 / 'Library/K3OsFdtLib/Test/Include'
+
+
+class PlatformConfigTests(unittest.TestCase):
+    def test_boot_snapshot(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            tmp = Path(tmp)
+            for path in ['Protocol/ClockCtrl.h', 'Library/BaseMemoryLib.h']:
+                header = tmp / path
+                header.parent.mkdir(exist_ok=True)
+                header.touch()
+            exe = tmp / 'snapshot'
+            subprocess.run([
+                'cc', '-std=c11', '-fshort-wchar', '-Wall', '-Werror',
+                '-I', tmp, '-I', HOST, '-I', K3 / 'Include', '-I', K3 / 'Drivers',
+                '-I', K3 / 'Drivers/K3PlatformConfigDxe',
+                ROOT / 'tools/tests/platform_config_host.c', '-o', exe
+            ], check=True)
+            subprocess.run([exe], check=True)
