@@ -0,0 +1,219 @@
+/** @file
+  Present the immutable K3 boot snapshot in Platform Manager.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include <Library/HiiLib.h>
+#include <Library/PrintLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Protocol/DevicePath.h>
+#include <Protocol/HiiConfigAccess.h>
+#include <Protocol/K3PlatformConfig.h>
+#include "K3PlatformConfigForm.h"
+
+extern UINT8  K3PlatformConfigBin[];
+extern UINT8  K3PlatformConfigHiiDxeStrings[];
+
+STATIC EFI_HII_HANDLE               mHiiHandle;
+STATIC K3_PLATFORM_CONFIG_PROTOCOL  *mConfig;
+
+STATIC struct {
+  VENDOR_DEVICE_PATH          Vendor;
+  EFI_DEVICE_PATH_PROTOCOL    End;
+} mPath = {
+  {
+    { HARDWARE_DEVICE_PATH, HW_VENDOR_DP, { sizeof (VENDOR_DEVICE_PATH), 0 } },
+    K3_CONFIG_FORMSET_GUID
+  },
+  { END_DEVICE_PATH_TYPE, END_ENTIRE_DEVICE_PATH_SUBTYPE, { sizeof (EFI_DEVICE_PATH_PROTOCOL), 0 } }
+};
+
+// Display only the named controller indices. The raw mask remains visible even
+// if a future SKU introduces bits outside the current controller registry.
+STATIC
+VOID
+SetMaskString (
+  IN EFI_STRING_ID  Token,
+  IN UINT8          Mask,
+  IN CONST CHAR16   *Ids
+  )
+{
+  UINTN   Index;
+  UINTN   Used;
+  CHAR16  Selected[16];
+  CHAR16  Text[48];
+
+  Used = 0;
+  for (Index = 0; Ids[Index] != 0; Index++) {
+    if ((Mask & (1U << Index)) != 0) {
+      if (Used != 0) {
+        Selected[Used++] = L',';
+      }
+
+      Selected[Used++] = Ids[Index];
+    }
+  }
+
+  Selected[Used] = 0;
+  UnicodeSPrint (Text, sizeof (Text), L"0x%02x (%s)", Mask, Used ? Selected : L"none listed");
+  HiiSetString (mHiiHandle, Token, Text, NULL);
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ConfigCallback (
+  IN CONST EFI_HII_CONFIG_ACCESS_PROTOCOL  *This,
+  IN EFI_BROWSER_ACTION                    Action,
+  IN EFI_QUESTION_ID                       QuestionId,
+  IN UINT8                                 Type,
+  IN EFI_IFR_TYPE_VALUE                    *Value,
+  OUT EFI_BROWSER_ACTION_REQUEST           *ActionRequest
+  )
+{
+  STATIC CONST CHAR16 *CONST  SkuNames[] = { L"DEFAULT", L"COM260", L"FML13V05", L"EVB" };
+  STATIC CONST CHAR16 *CONST  Modes[] = { L"Device tree (legacy)", L"ACPI", L"Device tree (firmware-owned)" };
+  STATIC CONST CHAR16 *CONST  UsbStates[] = { L"Unknown ceiling", L"Disabled", L"High-speed ceiling", L"SuperSpeed ceiling" };
+  STATIC CONST EFI_STRING_ID  UsbTokens[] = {
+    STRING_TOKEN (STR_USB0_VALUE), STRING_TOKEN (STR_USB1_VALUE), STRING_TOKEN (STR_USB2_VALUE),
+    STRING_TOKEN (STR_USB3_VALUE), STRING_TOKEN (STR_USB4_VALUE)
+  };
+  K3_PLATFORM_CONFIG_SNAPSHOT  Snapshot;
+  EFI_STATUS                   Status;
+  UINTN                        Index;
+  CHAR16                       Text[80];
+
+  if ((Action != EFI_BROWSER_ACTION_FORM_OPEN) || (QuestionId != K3_CONFIG_OPEN_KEY)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  if (ActionRequest == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *ActionRequest = EFI_BROWSER_ACTION_REQUEST_NONE;
+  Status = mConfig->GetSnapshot (&Snapshot, sizeof (Snapshot));
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if ((Snapshot.Revision != K3_PLATFORM_CONFIG_REVISION) || (Snapshot.Size != sizeof (Snapshot))) {
+    return EFI_INCOMPATIBLE_VERSION;
+  }
+
+  if (Snapshot.FirmwareVersion[0] != 0) {
+    HiiSetString (mHiiHandle, STRING_TOKEN (STR_VERSION_VALUE), Snapshot.FirmwareVersion, NULL);
+  }
+
+  UnicodeSPrint (
+    Text, sizeof (Text), L"%s (%Lu)",
+    Snapshot.Sku < ARRAY_SIZE (SkuNames) ? SkuNames[Snapshot.Sku] : L"Unknown", Snapshot.Sku
+    );
+  HiiSetString (mHiiHandle, STRING_TOKEN (STR_SKU_VALUE), Text, NULL);
+  if (Snapshot.DescriptionMode < ARRAY_SIZE (Modes)) {
+    HiiSetString (mHiiHandle, STRING_TOKEN (STR_MODE_VALUE), (EFI_STRING)Modes[Snapshot.DescriptionMode], NULL);
+  }
+
+  UnicodeSPrint (Text, sizeof (Text), L"%u", Snapshot.Revision);
+  HiiSetString (mHiiHandle, STRING_TOKEN (STR_REVISION_VALUE), Text, NULL);
+  SetMaskString (STRING_TOKEN (STR_GMAC_VALUE), Snapshot.GmacMask, L"0123");
+  SetMaskString (STRING_TOKEN (STR_PCIE_VALUE), Snapshot.PcieMask, L"ABCDE");
+  if (Snapshot.UsbEnableMask == 0xFF) {
+    HiiSetString (mHiiHandle, STRING_TOKEN (STR_USB_FILTER_VALUE), L"0xFF (controller defaults)", NULL);
+  } else {
+    SetMaskString (STRING_TOKEN (STR_USB_FILTER_VALUE), Snapshot.UsbEnableMask, L"01234");
+  }
+
+  for (Index = 0; (Index < Snapshot.UsbCount) && (Index < ARRAY_SIZE (UsbTokens)); Index++) {
+    if (Snapshot.UsbState[Index] < ARRAY_SIZE (UsbStates)) {
+      HiiSetString (mHiiHandle, UsbTokens[Index], (EFI_STRING)UsbStates[Snapshot.UsbState[Index]], NULL);
+    }
+  }
+
+  if (Snapshot.UfsAclkHz == 0) {
+    HiiSetString (mHiiHandle, STRING_TOKEN (STR_UFS_VALUE), L"Driver default", NULL);
+  } else {
+    UnicodeSPrint (Text, sizeof (Text), L"%Lu Hz", Snapshot.UfsAclkHz);
+    HiiSetString (mHiiHandle, STRING_TOKEN (STR_UFS_VALUE), Text, NULL);
+  }
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ExtractConfig (
+  IN CONST EFI_HII_CONFIG_ACCESS_PROTOCOL  *This,
+  IN CONST EFI_STRING                      Request,
+  OUT EFI_STRING                           *Progress,
+  OUT EFI_STRING                           *Results
+  )
+{
+  if ((Progress == NULL) || (Results == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *Progress = Request;
+  *Results  = NULL;
+  return EFI_NOT_FOUND;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+RouteConfig (
+  IN CONST EFI_HII_CONFIG_ACCESS_PROTOCOL  *This,
+  IN CONST EFI_STRING                      Configuration,
+  OUT EFI_STRING                           *Progress
+  )
+{
+  if ((Configuration == NULL) || (Progress == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *Progress = Configuration;
+  return EFI_NOT_FOUND;
+}
+
+STATIC EFI_HII_CONFIG_ACCESS_PROTOCOL  mConfigAccess = { ExtractConfig, RouteConfig, ConfigCallback };
+
+EFI_STATUS
+EFIAPI
+K3ConfigHiiEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  Handle;
+
+  Status = gBS->LocateProtocol (&gK3PlatformConfigProtocolGuid, NULL, (VOID **)&mConfig);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if (mConfig->Revision != K3_PLATFORM_CONFIG_REVISION) {
+    return EFI_INCOMPATIBLE_VERSION;
+  }
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle, &gEfiDevicePathProtocolGuid, &mPath,
+                  &gEfiHiiConfigAccessProtocolGuid, &mConfigAccess, NULL
+                  );
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  mHiiHandle = HiiAddPackages (
+                 &mPath.Vendor.Guid, Handle, K3PlatformConfigBin, K3PlatformConfigHiiDxeStrings, NULL
+                 );
+  if (mHiiHandle == NULL) {
+    gBS->UninstallMultipleProtocolInterfaces (
+           Handle, &gEfiDevicePathProtocolGuid, &mPath,
+           &gEfiHiiConfigAccessProtocolGuid, &mConfigAccess, NULL
+           );
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  return EFI_SUCCESS;
+}
