@@ -0,0 +1,106 @@
+/** @file
+  Publish the selected firmware defaults without accessing controller hardware.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include <Library/BaseMemoryLib.h>
+#include <Library/PcdLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Protocol/K3PlatformConfig.h>
+#include "../UsbHcdInitDxe/UsbHostPcdConfig.h"
+
+STATIC K3_PLATFORM_CONFIG_SNAPSHOT  mSnapshot;
+
+STATIC
+EFI_STATUS
+EFIAPI
+GetSnapshot (
+  OUT K3_PLATFORM_CONFIG_SNAPSHOT  *Snapshot,
+  IN  UINTN                        BufferSize
+  )
+{
+  if (Snapshot == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (BufferSize < sizeof (mSnapshot)) {
+    return EFI_BUFFER_TOO_SMALL;
+  }
+
+  CopyMem (Snapshot, &mSnapshot, sizeof (mSnapshot));
+  return EFI_SUCCESS;
+}
+
+STATIC K3_PLATFORM_CONFIG_PROTOCOL  mProtocol = {
+  K3_PLATFORM_CONFIG_REVISION,
+  GetSnapshot
+};
+
+STATIC
+VOID
+CaptureUsbDefaults (
+  VOID
+  )
+{
+  CONST USB_HOST_CONTROLLER_HW_ARRAY  *Usb;
+  UINTN                               Index;
+  UINTN                               Size;
+
+  Usb  = PcdGetPtr (PcdUsbHostControllers);
+  Size = PcdGetSize (PcdUsbHostControllers);
+  mSnapshot.UsbCount = 0;
+  if ((Size < OFFSET_OF (USB_HOST_CONTROLLER_HW_ARRAY, Controller)) ||
+      (Usb->Num > ARRAY_SIZE (mSnapshot.UsbState)) ||
+      (Usb->Num > ARRAY_SIZE (Usb->Controller)) ||
+      (Size < OFFSET_OF (USB_HOST_CONTROLLER_HW_ARRAY, Controller) + Usb->Num * sizeof (Usb->Controller[0]))) {
+    return;
+  }
+
+  mSnapshot.UsbCount = (UINT8)Usb->Num;
+  for (Index = 0; Index < Usb->Num; Index++) {
+    // Match the filtering and maximum-speed order in UsbHcd.c.
+    if ((mSnapshot.UsbEnableMask != 0xFF) && ((mSnapshot.UsbEnableMask & (1U << Index)) == 0)) {
+      mSnapshot.UsbState[Index] = K3_USB_OFF;
+    } else if (((mSnapshot.UsbHsOnlyMask & (1U << Index)) != 0) ||
+               (Usb->Controller[Index].MaxSpeed == USB_SPEED_HIGH)) {
+      mSnapshot.UsbState[Index] = K3_USB_HIGH;
+    } else if (Usb->Controller[Index].MaxSpeed == USB_SPEED_SUPER) {
+      mSnapshot.UsbState[Index] = K3_USB_SUPER;
+    } else {
+      mSnapshot.UsbState[Index] = K3_USB_UNKNOWN;
+    }
+  }
+}
+
+EFI_STATUS
+EFIAPI
+K3PlatformConfigEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  CONST CHAR16  *Version;
+  UINTN         Size;
+  EFI_HANDLE    Handle;
+
+  mSnapshot.Revision        = K3_PLATFORM_CONFIG_REVISION;
+  mSnapshot.Size            = sizeof (mSnapshot);
+  mSnapshot.Generation      = 1;
+  mSnapshot.Sku             = LibPcdGetSku ();
+  mSnapshot.DescriptionMode = FixedPcdGet8 (PcdK3ConfigDescriptionMode);
+  mSnapshot.GmacMask        = PcdGet8 (PcdGmacUseMask);
+  mSnapshot.PcieMask        = PcdGet8 (PcdPcieHostEnableMask);
+  mSnapshot.UsbEnableMask   = PcdGet8 (PcdUsbHostEnableMask);
+  mSnapshot.UsbHsOnlyMask   = PcdGet8 (PcdUsbHostHsOnlyMask);
+  mSnapshot.UfsAclkHz       = PcdGet64 (PcdUfsAclkRate);
+  CaptureUsbDefaults ();
+
+  Version = (CONST CHAR16 *)PcdGetPtr (PcdFirmwareVersionString);
+  Size    = PcdGetSize (PcdFirmwareVersionString);
+  if ((Size >= sizeof (CHAR16)) && ((Size % sizeof (CHAR16)) == 0) &&
+      (Size <= sizeof (mSnapshot.FirmwareVersion)) && (Version[Size / sizeof (CHAR16) - 1] == 0)) {
+    CopyMem (mSnapshot.FirmwareVersion, Version, Size);
+  }
+
+  Handle = NULL;
+  return gBS->InstallProtocolInterface (&Handle, &gK3PlatformConfigProtocolGuid, EFI_NATIVE_INTERFACE, &mProtocol);
+}
