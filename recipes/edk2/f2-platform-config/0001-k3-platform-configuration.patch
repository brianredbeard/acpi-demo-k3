diff --git a/Silicon/Spacemit/K3/Drivers/K3PlatformConfigHiiDxe/K3PlatformConfigHiiDxe.c b/Silicon/Spacemit/K3/Drivers/K3PlatformConfigHiiDxe/K3PlatformConfigHiiDxe.c
