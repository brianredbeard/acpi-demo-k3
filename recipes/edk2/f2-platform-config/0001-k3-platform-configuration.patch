diff --git a/Silicon/Spacemit/K3/Include/Protocol/K3PlatformConfig.h b/Silicon/Spacemit/K3/Include/Protocol/K3PlatformConfig.h
new file mode 100644
index 00000000..446f0025
--- /dev/null
+++ b/Silicon/Spacemit/K3/Include/Protocol/K3PlatformConfig.h
@@ -0,0 +1,50 @@
+/** @file
+  Snapshot of firmware configuration inputs after SKU selection.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#ifndef K3_PLATFORM_CONFIG_H_
+#define K3_PLATFORM_CONFIG_H_
+
+#include <Uefi.h>
+
+#define K3_PLATFORM_CONFIG_REVISION  1
+#define K3_CONFIG_MAX_USB            5
+
+#define K3_USB_UNKNOWN  0
+#define K3_USB_OFF      1
+#define K3_USB_HIGH     2
+#define K3_USB_SUPER    3
+
+typedef struct {
+  UINT32    Revision;
+  UINT32    Size;
+  UINT64    Generation;
+  UINT64    Sku;
+  UINT64    UfsAclkHz;
+  CHAR16    FirmwareVersion[64];
+  UINT8     DescriptionMode;
+  UINT8     GmacMask;
+  UINT8     PcieMask;
+  UINT8     UsbEnableMask;
+  UINT8     UsbHsOnlyMask;
+  UINT8     UsbCount;
+  UINT8     UsbState[K3_CONFIG_MAX_USB]; // Indexed by firmware controller ID.
+} K3_PLATFORM_CONFIG_SNAPSHOT;
+
+// Up to TPL_CALLBACK. Copies a complete immutable record to caller storage.
+// No variable I/O, hardware access or status updates occur after publication.
+typedef
+EFI_STATUS
+(EFIAPI *K3_GET_CONFIG_SNAPSHOT)(
+  OUT K3_PLATFORM_CONFIG_SNAPSHOT  *Snapshot,
+  IN UINTN                         BufferSize
+  );
+
+typedef struct {
+  UINT32                    Revision;
+  K3_GET_CONFIG_SNAPSHOT    GetSnapshot;
+} K3_PLATFORM_CONFIG_PROTOCOL;
+
+extern EFI_GUID  gK3PlatformConfigProtocolGuid;
+
+#endif
