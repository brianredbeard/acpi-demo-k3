 #define MPHY_RX_FSM_STATE	0xC1
 #define MPHY_TX_FSM_STATE	0x41
 
+/*
+ * APMU UFS clk/res control (see drivers/clk/spacemit/ccu-k3.c and
+ * drivers/reset/spacemit/reset-spacemit-k3.c): gate BIT(1), reset
+ * BIT(0) with the reset asserted when the bit is LOW.
+ */
+#define APMU_UFS_RESET_MASK		BIT(0)
+
 static int ufs_spacemit_dme_set(struct ufs_hba *hba,
 				const struct ufshcd_dme_attr_val *v, int n)
 {
@@ -430,6 +439,112 @@
 	hba->quirks |= UFSHCD_QUIRK_BROKEN_AUTO_HIBERN8;
