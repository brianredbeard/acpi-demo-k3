-EFI_STATUS
-PollRegStatus (
-  IN UINTN   RegAddr,
-  IN UINT32  Mask,
-  IN UINT32  Value,
-  IN UINT32  TimeoutUs
-  )
-{
-  while (1) {
-    if (Value == (MmioRead32 (RegAddr) & Mask)) {
-      break;
-    }
-
-    gBS->Stall (1);
-    if (!TimeoutUs--) {
-      DEBUG (
-             (DEBUG_ERROR,
-              "Timeout while poll 0x%x for Val 0x%x!\n", RegAddr, Value)
-             );
-      return EFI_TIMEOUT;
-    }
-  }
-
-  return EFI_SUCCESS;
-}
