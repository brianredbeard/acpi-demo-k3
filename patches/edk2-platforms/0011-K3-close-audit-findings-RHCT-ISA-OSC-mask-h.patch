+/*
+ * Complete X100 ISA string from K3Cpus.dtsi. Under ACPI the kernel does
+ * NOT imply zicsr/zifencei/zicntr/zihpm from the base letters (unlike
+ * DT), so every implemented extension must be listed explicitly; a
+ * missing name silently drops the corresponding HWCAP bit and
+ * userspace/perf capability. CPU0-7 (X100) carry the hypervisor and
+ * vector-crypto sets; CPU8-15 (A100, not ACPI-described) lack h/v.
+ */
+#define ISA_STRING         "rv64imafdcvh_zicbom_zicboz_zicntr_zicond_zicsr_zifencei_zihintpause_zihpm_zfh_zfhmin_zba_zbb_zbc_zbs_zkt_zvbb_zvbc_zvfh_zvfhmin_zvkb_zvkg_zvkn_zvknc_zvkned_zvkng_zvknha_zvknhb_zvks_zvksc_zvksed_zvksh_zvksg_zvkt_ssaia_sscofpmf_sstc_svinval_svnapot_svpbmt_smstateen"
