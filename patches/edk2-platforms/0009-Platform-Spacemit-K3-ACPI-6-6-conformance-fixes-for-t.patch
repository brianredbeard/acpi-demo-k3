-        ResourceProducer,
-        PosDecode,
-        MinFixed,
-        MaxFixed,
-        NonCacheable,
-        ReadWrite,
-        0x0,           // AddressGranularity, should be 2^n - 1
-        0x80000000,    // AddressMinimum
-        0x80000FFF,    // AddressMaximum
-        0x00000000,    // AddressTranslation
-        0x1000         // RangeLength
-      )
-    })
