+        },                                                \
+        ResourceTemplate () {                             \
+          Register(FFixedHW, 64, 0,                       \
+               0x100000000000000D,                        \
+               4)                                         \
+        },                                                \
+        ResourceTemplate () {                             \
+          Register(SystemMemory, 0, 0, 0, 0)              \
+        },                                                \
+        ResourceTemplate () {                             \
+          Register(SystemMemory, 0, 0, 0, 0)              \
+        },                                                \
+        ResourceTemplate () {                             \
