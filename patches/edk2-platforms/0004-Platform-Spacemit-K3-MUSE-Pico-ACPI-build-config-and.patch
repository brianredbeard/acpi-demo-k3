From 14c8b4a71a54ea566dc876694e22829029611f42 Mon Sep 17 00:00:00 2001
From: Brian 'redbeard' Harrington <redbeard@dead-city.org>
Date: Thu, 19 Nov 2026 17:07:41 -0800
Subject: [PATCH 4/7] Platform/Spacemit/K3/MUSE-Pico: ACPI build config and
 quiet console

- Wire K3AcpiClockInitDxe into the ACPI_ENABLE build sections (DSC
  components and FDF).
- Status-code reporting: keep the progress-code bit off in DEBUG
  builds too (PcdReportStatusCodePropertyMask 0x02). The ~50
  "PROGRESS CODE" lines per boot interleave with GRUB menu redraws
  and consume the menu timeout at 115200 baud.
- Spacemit.dsc.inc: DEBUG prints errors-only
  (PcdDebugPrintErrorLevel 0x80000000) for the same reason.
- Install the ACPI SDT protocol (enabler for the DSDT-patching NVS
  work; harmless otherwise).
---
 Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.dsc | 14 ++++++++++----
 Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.fdf |  1 +
 Silicon/Spacemit/Spacemit.dsc.inc            |  4 +++-
 3 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.dsc b/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.dsc
index b9c9f20e..535cebba 100644
--- a/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.dsc
+++ b/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.dsc
@@ -268,11 +268,10 @@
   #   bit0 (0x01) = progress codes  -> prints "PROGRESS CODE: V... I..." on serial
   #   bit1 (0x02) = error codes     -> prints "ERROR: C...:V... I..." on serial
   #   bit2 (0x04) = debug codes     -> routes DEBUG() output through status code
-!if $(TARGET) == RELEASE
+  # Progress codes are pure noise on the serial console (one line per firmware
+  # event; ~50 lines per boot, interleaved with GRUB menu redraws) and consume
+  # the GRUB menu timeout at 115200 baud. Keep them off in DEBUG builds too.
   gEfiMdePkgTokenSpaceGuid.PcdReportStatusCodePropertyMask|0x02
-!else
-  gEfiMdePkgTokenSpaceGuid.PcdReportStatusCodePropertyMask|0x07
-!endif
 
   gSpacemitK3TokenSpaceGuid.PcdSpacemitMPMURegBase|0xd4050000
   gSpacemitK3TokenSpaceGuid.PcdSpacemitAPMURegBase|0xd4282800
@@ -686,6 +685,8 @@
 
 !if $(ACPI_ENABLE) == TRUE
   gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiExposedTableVersions|0x20
+  # Required so K3AcpiNvsDxe can walk/patch the DSDT via the ACPI SDT protocol.
+  gEfiMdeModulePkgTokenSpaceGuid.PcdInstallAcpiSdtProtocol|TRUE
   # definition of X100
   gSpacemitK3TokenSpaceGuid.PcdX100HartCount|0x8
 
@@ -870,6 +871,11 @@
   MdeModulePkg/Universal/Acpi/AcpiPlatformDxe/AcpiPlatformDxe.inf
   # ACPI tables
   Platform/Spacemit/K3/AcpiTables/K3AcpiTables.inf
+  # Deterministic OS-visible device-block clock bring-up at ReadyToBoot
+  # (GMAC/PCIe/USB/TSEN): ACPI leaves clock control to firmware, so every
+  # OS-driven block must be clocked and out of reset at handoff even if BDS
+  # never connected it.
+  Silicon/Spacemit/K3/Drivers/AcpiClockInitDxe/K3AcpiClockInitDxe.inf
 !elseif $(K3_OS_DTB_ENABLE) == FALSE
   Silicon/RISC-V/ProcessorPkg/Universal/FdtDxe/FdtDxe.inf {
     <LibraryClasses>
diff --git a/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.fdf b/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.fdf
index 1c36effe..a6ed3b5a 100644
--- a/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.fdf
+++ b/Platform/Spacemit/K3/MUSE-Pico/MUSE-Pico.fdf
@@ -222,6 +222,7 @@ INF Silicon/Spacemit/K3/Drivers/CompatibleFixupDxe/CompatibleFixupDxe.inf
 INF  MdeModulePkg/Universal/Acpi/AcpiTableDxe/AcpiTableDxe.inf
 INF  MdeModulePkg/Universal/Acpi/AcpiPlatformDxe/AcpiPlatformDxe.inf
 INF  RuleOverride = ACPITABLE Platform/Spacemit/K3/AcpiTables/K3AcpiTables.inf
+INF  Silicon/Spacemit/K3/Drivers/AcpiClockInitDxe/K3AcpiClockInitDxe.inf
 
 !elseif $(K3_OS_DTB_ENABLE) == FALSE
 INF  Silicon/RISC-V/ProcessorPkg/Universal/FdtDxe/FdtDxe.inf
diff --git a/Silicon/Spacemit/Spacemit.dsc.inc b/Silicon/Spacemit/Spacemit.dsc.inc
index 31222d7a..855d9e06 100644
--- a/Silicon/Spacemit/Spacemit.dsc.inc
+++ b/Silicon/Spacemit/Spacemit.dsc.inc
@@ -252,7 +252,9 @@
   #                              // significantly impact boot performance
   #  DEBUG_ERROR     0x80000000  // Error
 !if $(DEBUG_ON_SERIAL_PORT) == TRUE
-  gEfiMdePkgTokenSpaceGuid.PcdDebugPrintErrorLevel|0x80000047
+  # Errors only: INFO/LOAD/WARN/INIT debug prints flood the serial console and
+  # slow the GRUB menu countdown (see MUSE-Pico.dsc status-code mask note).
+  gEfiMdePkgTokenSpaceGuid.PcdDebugPrintErrorLevel|0x80000000
 !endif
 
   #
