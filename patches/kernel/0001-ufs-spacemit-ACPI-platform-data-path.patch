+/*
+ * ACPI (PRP0001) path. dev->of_node is NULL under ACPI, so
+ * ufshcd_pltfrm_init()'s of_property_* parsing produces an empty clock
+ * list and ufs_spacemit_init()'s DT reset lookup fails. This path
+ * builds the same hba state from _DSD properties and the RPMI-served
+ * clocks (registered by clk-rpmi with con_id == clock name).
+ */
+static const struct {
+	const char *list_name;
+	const char *rpmi_name;
+} ufs_acpi_clocks[] = {
+	{ "axi", "ufs_aclk" },
+	/*
+	 * "ref" (ufs_refclk) is deliberately NOT in the list: the
+	 * firmware leaves it enabled and the RPMI clock server reports
+	 * RPMI_ERR_ALREADY (-EALREADY) for enable-when-enabled, which
+	 * would fail the core's ufshcd_setup_clocks(). The refclk rate
+	 * is fixed (19.2 MHz) and the driver only needs it for OPP
+	 * scaling, which the ACPI path does not use.
+	 */
+};
+
+static void ufs_spacemit_acpi_init(struct ufs_hba *hba)
+{
+	struct device *dev = hba->dev;
+	struct ufs_clk_info *clki;
+
+	/* lanes-per-direction (ufshcd core default is 2) */
+	device_property_read_u32(dev, "lanes-per-direction",
+				 &hba->lanes_per_direction);
+	/* ufshcd core default is 2 lanes per direction */
+	if (!hba->lanes_per_direction)
+		hba->lanes_per_direction = 2;
+
+	/*
+	 * ufshcd_init() -> ufshcd_init_clocks() resolves every entry by
+	 * LIST NAME via devm_clk_get(dev, name). Register clkdev aliases
+	 * "axi"/"ref" -> the RPMI clock names first, then let the CORE
+	 * do the acquisition exactly as in the DT path. This avoids any
+	 * double ownership of the clk pointer.
+	 */
+	for (unsigned int i = 0; i < ARRAY_SIZE(ufs_acpi_clocks); i++) {
+		struct clk *probe = clk_get(dev, ufs_acpi_clocks[i].rpmi_name);
+
+		if (IS_ERR(probe)) {
+			/*
+			 * Miss here means sys1clk falls back to the
+			 * 409.6 MHz constant — 20% off the real rate.
+			 * Loud on purpose.
+			 */
+			dev_info(dev, "clock %s not resolved (ret %ld); %s-rate timing will use the fallback constant\n",
+				 ufs_acpi_clocks[i].rpmi_name, PTR_ERR(probe),
+				 ufs_acpi_clocks[i].list_name);
+			continue;
+		}
+		clk_put(probe);
+
+		if (clk_add_alias(ufs_acpi_clocks[i].list_name, NULL,
+				  ufs_acpi_clocks[i].rpmi_name, dev)) {
+			dev_info(dev, "clkdev alias %s -> %s failed\n",
+				 ufs_acpi_clocks[i].list_name,
+				 ufs_acpi_clocks[i].rpmi_name);
+			continue;
+		}
+
+		/* Pre-populate the list so the core enables the clock. */
+		clki = devm_kzalloc(dev, sizeof(*clki), GFP_KERNEL);
+		if (!clki)
+			continue;
+		clki->name = devm_kstrdup(dev, ufs_acpi_clocks[i].list_name,
+					  GFP_KERNEL);
+		clki->min_freq = 0;
+		clki->max_freq = ULONG_MAX;
+		list_add_tail(&clki->list, &hba->clk_list_head);
+	}
+}
+
+/*
+ * Map the APMU UFS clk/res control register from the _DSD property
+ * "spacemit,apmu-ufs-reg" (absolute address) and run the same
+ * assert/deassert sequence as the DT reset controller. Without the
+ * property the firmware-programmed reset state is kept (the firmware
+ * leaves the UFS reset deasserted).
+ */
+static int ufs_spacemit_acpi_reset(struct device *dev)
+{
+	struct regmap_config cfg = {
+		.reg_bits = 32,
+		.val_bits = 32,
+		.reg_stride = 4,
+	};
+	struct regmap *apmu;
+	void __iomem *base;
+	u32 reg = 0;
+	int ret;
+
+	device_property_read_u32(dev, "spacemit,apmu-ufs-reg", &reg);
+	if (!reg) {
+		dev_info(dev, "no spacemit,apmu-ufs-reg, keeping firmware reset state\n");
+		return 0;
+	}
+	base = devm_ioremap(dev, reg, 4);
+	if (!base)
+		return -ENOMEM;
+	apmu = devm_regmap_init_mmio(dev, base, &cfg);
+	if (IS_ERR(apmu))
+		return PTR_ERR(apmu);
+
+	/* reset asserted low: clear, pause, set */
+	ret = regmap_update_bits(apmu, 0, APMU_UFS_RESET_MASK, 0);
+	if (ret)
+		return ret;
+	usleep_range(10, 15);
+	ret = regmap_update_bits(apmu, 0, APMU_UFS_RESET_MASK,
+				 APMU_UFS_RESET_MASK);
+	if (ret)
+		return ret;
+	usleep_range(10, 15);
+	return 0;
+}
