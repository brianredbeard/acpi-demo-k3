 /**
+ * cros_ec_device_alloc() - Allocate and initialize a cros_ec_device.
+ * @dev: Device allocating the EC device (managed).
+ *
+ * The RHEL 6.12 tree's cros-ec transports allocate inline; the newer
+ * cros_ec_espi backport expects this helper. Provides it.
+ */
+static inline struct cros_ec_device *cros_ec_device_alloc(struct device *dev)
+{
+	return devm_kzalloc(dev, sizeof(struct cros_ec_device), GFP_KERNEL);
+}
