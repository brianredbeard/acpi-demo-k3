+/*
+ * Under ACPI there are no named platform resources, so the by-name
+ * lookups in stmmac_get_platform_resources() ("macirq" etc.) cannot
+ * succeed. Use the first interrupt from _CRS and treat the optional
+ * ones as absent; stmmac core guards every optional IRQ with a
+ * "> 0" check.
+ */
+static int spacemit_dwmac_get_resources(struct platform_device *pdev,
+					 struct stmmac_resources *stmmac_res)
+{
+	/*
+	 * Gate on the ACPI companion, NOT of_node: the ACPI-OF glue
+	 * synthesizes a non-NULL of_node for PRP0001 devices at boot
+	 * (the espi v2 lesson), sending this through the DT byname
+	 * lookup ("macirq") which cannot succeed under ACPI. The node
+	 * state differs between first probe and rebind, so of_node is
+	 * not a reliable discriminator.
+	 */
+	if (pdev->dev.of_node && !has_acpi_companion(&pdev->dev))
+		return stmmac_get_platform_resources(pdev, stmmac_res);
+
+	memset(stmmac_res, 0, sizeof(*stmmac_res));
+
+	stmmac_res->irq = platform_get_irq(pdev, 0);
+	if (stmmac_res->irq < 0)
+		return stmmac_res->irq;
+
+	stmmac_res->wol_irq = -ENXIO;
+	stmmac_res->lpi_irq = -ENXIO;
+	stmmac_res->sfty_irq = -ENXIO;
+
+	stmmac_res->addr = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(stmmac_res->addr))
+		return PTR_ERR(stmmac_res->addr);
+
+	return 0;
+}
