+/*
+ * Build the stmmac platform data from the _DSD properties of a PRP0001
+ * ACPI device. This mirrors the defaults and the property parsing of
+ * stmmac_probe_config_dt(), but uses the firmware-agnostic device
+ * property API, which transparently reads either DT properties or ACPI
+ * _DSD properties.
+ *
+ * Clocks are not acquired under ACPI: firmware (e.g. EDK2) is expected
+ * to have enabled the GMAC clocks before boot, so the driver only needs
+ * to tolerate their absence.
+ */
+static struct plat_stmmacenet_data *
+spacemit_dwmac_probe_config_acpi(struct platform_device *pdev,
+				 struct stmmac_resources *stmmac_res)
+{
+	struct plat_stmmacenet_data *plat;
+	struct stmmac_dma_cfg *dma_cfg;
+	struct device *dev = &pdev->dev;
+	int phy_mode;
+
+	if (device_property_read_u8_array(dev, "mac-address",
+					       stmmac_res->mac, ETH_ALEN))
+		device_property_read_u8_array(dev, "local-mac-address",
+					       stmmac_res->mac, ETH_ALEN);
+
+	phy_mode = device_get_phy_mode(dev);
+
+	plat = devm_kzalloc(dev, sizeof(*plat), GFP_KERNEL);
+	if (!plat)
+		return ERR_PTR(-ENOMEM);
+
+	phy_mode = device_get_phy_mode(dev);
+	if (phy_mode < 0)
+		return ERR_PTR(phy_mode);
+	plat->phy_interface = phy_mode;
+
+	/* phylink uses the firmware node for fixed-link and phy-handle. */
+	plat->port_node = dev_fwnode(dev);
+	plat->bus_id = pdev->id >= 0 ? pdev->id : 0;
+	plat->phy_addr = -1;
+	plat->clk_csr = -1;
+
+	plat->maxmtu = JUMBO_LEN;
+	plat->multicast_filter_bins = HASH_TABLE_SIZE;
+	plat->unicast_filter_entries = 1;
+
+	device_property_read_u32(dev, "max-speed", &plat->max_speed);
+	device_property_read_u32(dev, "max-frame-size", &plat->maxmtu);
+	device_property_read_u32(dev, "tx-fifo-depth", &plat->tx_fifo_size);
+	device_property_read_u32(dev, "rx-fifo-depth", &plat->rx_fifo_size);
+	device_property_read_u32(dev, "snps,clk-csr", &plat->clk_csr);
+	device_property_read_u32(dev, "snps,phy-addr", &plat->phy_addr);
+	device_property_read_u32(dev, "snps,multicast-filter-bins",
+				 &plat->multicast_filter_bins);
+	device_property_read_u32(dev, "snps,perfect-filter-entries",
+				 &plat->unicast_filter_entries);
+
+	/*
+	 * No phy-handle and no fixed-link is described, so use the legacy
+	 * MDIO bus assumption: the bus is scanned and the first PHY found
+	 * is bound to the MAC.
+	 */
+	plat->mdio_bus_data = devm_kzalloc(dev,
+					   sizeof(*plat->mdio_bus_data),
+					   GFP_KERNEL);
+	if (!plat->mdio_bus_data)
+		return ERR_PTR(-ENOMEM);
+	plat->mdio_bus_data->needs_reset = true;
+
+	dma_cfg = devm_kzalloc(dev, sizeof(*dma_cfg), GFP_KERNEL);
+	if (!dma_cfg)
+		return ERR_PTR(-ENOMEM);
+	plat->dma_cfg = dma_cfg;
+
+	device_property_read_u32(dev, "snps,pbl", &dma_cfg->pbl);
+	if (!dma_cfg->pbl)
+		dma_cfg->pbl = DEFAULT_DMA_PBL;
+	device_property_read_u32(dev, "snps,txpbl", &dma_cfg->txpbl);
+	device_property_read_u32(dev, "snps,rxpbl", &dma_cfg->rxpbl);
+	dma_cfg->pblx8 = !device_property_read_bool(dev, "snps,no-pbl-x8");
+	dma_cfg->aal = device_property_read_bool(dev, "snps,aal");
+	dma_cfg->fixed_burst = device_property_read_bool(dev,
+							 "snps,fixed-burst");
+	dma_cfg->mixed_burst = device_property_read_bool(dev,
+							 "snps,mixed-burst");
+
+	/*
+	 * One RX and one TX queue in DCB mode, matching the
+	 * stmmac_mtl_setup() defaults for DT nodes without MTL subnode
+	 * descriptions.
+	 */
+	plat->rx_queues_to_use = 1;
+	plat->tx_queues_to_use = 1;
+	plat->rx_queues_cfg[0].mode_to_use = MTL_QUEUE_DCB;
+	plat->tx_queues_cfg[0].mode_to_use = MTL_QUEUE_DCB;
+
+	/*
+	 * The K3 DWMAC is a Synopsys 5.40a (GMAC4-family) core. Under DT
+	 * this comes from matching the "snps,dwmac-5.40a" compatible in
+	 * stmmac_probe_config_dt(); the default (DWMAC100) would select the
+	 * wrong register map and HW ops.
+	 */
+	plat->core_type = DWMAC_CORE_GMAC4;
+	plat->pmt = 1;
+	if (device_property_read_bool(dev, "snps,tso"))
+		plat->flags |= STMMAC_FLAG_TSO_EN;
+
+	return plat;
+}
+
+/*
+ * Map the APMU control and delay-line registers described by the _DSD
+ * properties "spacemit,apmu-ctrl-reg" and "spacemit,apmu-dline-reg"
+ * (absolute MMIO addresses). Returns a regmap covering both registers,
+ * or NULL when the properties are absent, in which case the settings
+ * programmed by earlier firmware are kept untouched.
+ */
+static struct regmap *
+spacemit_dwmac_acpi_apmu_map(struct device *dev,
+			     unsigned int *ctrl_offset,
+			     unsigned int *dline_offset)
+{
+	u32 ctrl_reg = 0, dline_reg = 0;
+	void __iomem *base;
+	struct regmap *apmu;
+	u32 lo, hi;
+
+	device_property_read_u32(dev, "spacemit,apmu-ctrl-reg", &ctrl_reg);
+	device_property_read_u32(dev, "spacemit,apmu-dline-reg", &dline_reg);
+
+	if (!ctrl_reg || !dline_reg) {
+		dev_info(dev,
+			 "no spacemit,apmu-*-reg properties, keeping firmware settings\n");
+		return NULL;
+	}
+
+	lo = min(ctrl_reg, dline_reg);
+	hi = max(ctrl_reg, dline_reg);
+
+	if (hi - lo > 0x1000) {
+		dev_warn(dev,
+			 "spacemit,apmu-*-reg registers too far apart, ignored\n");
+		return NULL;
+	}
+
+	base = devm_ioremap(dev, lo, hi - lo + 4);
+	if (!base)
+		return ERR_PTR(-ENOMEM);
+
+	apmu = devm_regmap_init_mmio(dev, base,
+				     &spacemit_dwmac_apmu_regmap_cfg);
+	if (IS_ERR(apmu))
+		return apmu;
+
+	*ctrl_offset = ctrl_reg - lo;
+	*dline_offset = dline_reg - lo;
+
+	return apmu;
+}
