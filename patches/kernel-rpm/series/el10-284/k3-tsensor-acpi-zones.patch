+/*
+ * ACPI-mode cdev binding: the 6.12 thermal core only binds a
+ * cooling device to a zone through tz->ops.should_bind (the
+ * OF zones use thermal_of_should_bind via cooling-maps; ACPI
+ * zones registered by this driver have no OF node behind the
+ * zone, so without this hook the pwm-fan cooling device never
+ * binds and the fan stays at its probe-time max).
+ *
+ * Policy: bind the pwm-fan cdev to every trip with the full
+ * cdev state range; the governor (step_wise) then drives the
+ * fan between the cooling states per trip.
+ */
+static bool k3_tz_should_bind(struct thermal_zone_device *tz,
+			      const struct thermal_trip *trip,
+			      struct thermal_cooling_device *cdev,
+			      struct cooling_spec *c)
+{
+	if (strcmp(cdev->type, "pwm-fan"))
+		return false;
+
+	c->upper = THERMAL_NO_LIMIT;
+	c->lower = 0;
+	c->weight = 1024;
+	return true;
+}
