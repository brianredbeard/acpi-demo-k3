 static const struct thermal_zone_device_ops k3_of_thermal_ops = {
 	.get_temp = k3_thermal_get_temp,
+	.should_bind = k3_tz_should_bind,
 	/* .set_trips = k3_thermal_set_trips, */
 };
 
