-		espi->pr_mem_base0 = lower_32_bits(range.start);
+	/*
+	 * Under ACPI (PRP0001) the device has no of_node: the DT helpers
+	 * above are NULL-safe no-ops, but of_range_to_resource() derefs
+	 * np via parser_init() -> of_n_addr_cells() and panics the boot
