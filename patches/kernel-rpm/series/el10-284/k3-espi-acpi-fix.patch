+	 * -> of_range_to_resource -> of_n_addr_cells+0xa, badaddr 0x68).
+	 * The PR window bases are _DSD properties on this board
+	 * (pr-mem-base0/1); the unified property layer below resolves
+	 * them under ACPI and the DT properties under DT.
+	 */
+	if (np) {
+		ret = of_range_to_resource(np, 0, &range);
+		if (!ret)
+			espi->pr_mem_base0 = lower_32_bits(range.start);
+	}
 
-	if (!of_property_read_u32(np, "pr-mem-base0", &value))
+	if (!device_property_read_u32(dev, "pr-mem-base0", &value))
 		espi->pr_mem_base0 = value;
 
 	if (!espi->pr_mem_base0)
