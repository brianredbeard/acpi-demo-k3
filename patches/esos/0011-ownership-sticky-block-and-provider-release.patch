diff --git a/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.c b/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.c
--- a/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.c
+++ b/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.c
@@ -14,6 +14,12 @@
 #include "k3_hsm.h"
 #include "k3_domain_ownership.h"
 
+/* RT-Thread nano's errno set lacks EPERM; the permission
+ * semantics (sticky unqualified blocker) need it. */
+#ifndef RT_EPERM
+#define RT_EPERM 1
+#endif
+
 static struct k3_cluster_domain k3_domains[K3_MAX_CLUSTERS];
 
 /*
@@ -57,8 +63,20 @@
 	if (!d)
 		return -RT_EINVAL;
 
-	if ((c >= K3_CONSUMER_CLASS_COUNT) || (c == K3_CONSUMER_UNKNOWN))
-		return -RT_EINVAL;	/* unknown ownership is a blocker */
+	if ((c >= K3_CONSUMER_CLASS_COUNT) || (c == K3_CONSUMER_UNKNOWN)) {
+		/*
+		 * Unknown ownership is a STICKY blocker: the domain stays
+		 * sleep-ineligible until an explicit k3_domain_qualify()
+		 * (the operator investigated and cleared it). Matches the
+		 * header contract comment.
+		 */
+		if (c == K3_CONSUMER_UNKNOWN) {
+			rt_base_t level = rt_hw_interrupt_disable();
+			d->qualified = 0;
+			rt_hw_interrupt_enable(level);
+		}
+		return -RT_EINVAL;
+	}
 
 	level = rt_hw_interrupt_disable();
 	if (d->state != K3_DOMAIN_ACTIVE) {
@@ -194,6 +212,31 @@
 		rt_hw_interrupt_enable(level);
 		return -RT_EBUSY;
 	}
+	/*
+	 * Atomic holder recheck (rhct12 audit, ESOS 0011 hold): the
+	 * provider release (X100_AP) may drop ITS hold while other
+	 * classes still hold — e.g. DMA with one reference outstanding.
+	 * The state machine alone (ACTIVE) does not establish sleep
+	 * safety. Recheck every consumer count under the SAME interrupt
+	 * mask as the state change so an acquisition racing this path
+	 * either blocks on the ENTERING_WAIT gate or is visible here.
+	 */
+	{
+		int c;
+
+		for (c = 0; c < K3_CONSUMER_CLASS_COUNT; c++) {
+			if (d->consumers[c]) {
+				rt_hw_interrupt_enable(level);
+				d->stats.denied_entry++;
+				return -RT_EPERM;
+			}
+		}
+		if (!d->qualified) {
+			rt_hw_interrupt_enable(level);
+			d->stats.denied_entry++;
+			return -RT_EPERM;
+		}
+	}
 	/* QUIESCE: the state change itself — the prepare gate and the
 	 * eligibility check deny new work from this point */
 	d->state = K3_DOMAIN_ENTERING_WAIT;
@@ -279,13 +322,27 @@
 
 	if (!d)
 		return -RT_EINVAL;
-	if (!k3_domain_cluster_quiesced(cluster))
-		return 0;
+	/*
+	 * The provider (X100 AP class) may release ITS OWN hold once the
+	 * cluster's cores are all stopped — even if other classes still
+	 * hold (they keep the domain ineligible; only the provider's
+	 * hold is surrendered). Idempotent: returns 1 on the first
+	 * effective release, 0 when nothing to release.
+	 */
+	{
+		rt_bool_t stopped;
 
-	level = rt_hw_interrupt_disable();
-	if (d->consumers[K3_CONSUMER_X100_AP])
+		level = rt_hw_interrupt_disable();
+		stopped = d->qualified &&
+			  (d->state == K3_DOMAIN_ACTIVE) &&
+			  hw_ops->cores_all_stopped(cluster);
+		if (!stopped || !d->consumers[K3_CONSUMER_X100_AP]) {
+			rt_hw_interrupt_enable(level);
+			return 0;
+		}
 		d->consumers[K3_CONSUMER_X100_AP]--;
-	rt_hw_interrupt_enable(level);
+		rt_hw_interrupt_enable(level);
+	}
 	return 1;
 }
 
@@ -364,7 +421,12 @@
 				eligible = RT_FALSE;
 		if (!eligible) {
 			rt_hw_interrupt_enable(level);
-			return -RT_ERROR;	/* unqualified or consumers active */
+			/*
+			 * Denial is a permission failure whether the cause is
+			 * the sticky unknown-ownership blocker or active
+			 * consumers (the retry contract is the caller's).
+			 */
+			return -RT_EPERM;
 		}
 	}
 
diff --git a/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.h b/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.h
--- a/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.h
+++ b/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.h
@@ -84,6 +84,7 @@
 	rt_uint32_t wake_timer;
 	rt_uint32_t wake_other;
 	rt_uint32_t aborted_entry;
+	rt_uint32_t denied_entry;	/* holder recheck / qualification denials */
 	rt_uint32_t stale_vote_rejected;
 	rt_uint32_t hw_handshake_timeouts;	/* audit fix 4 */
 };
