 		common->base = clk_info->apbs_base;
 		break;
@@ -1089,55 +1092,62 @@ int spacemit_ccu_init(void)
 				return -RT_ERROR;
 			}
 
-			ccu->clk_info.apmu_base = (void *)dtb_node_get_addr_index(compatible_node, 1);
