 				return -RT_ERROR;
@@ -1149,3 +1159,60 @@ int spacemit_ccu_init(void)
 
 	return 0;
 }
+
+/*
+ * spacemit_ccu_get_clk_by_name - resolve a registered CCU clock by name.
+ *
+ * Used by the RPMI clock service (k3-os0_clk.c) to forward RPMI requests
+ * to real clock control without OF-node/index coupling. The name is the
+ * ABI: it matches both the CCU clock table and the RPMI clock name served
+ * to Linux via RPMI CLOCK_GET_INFO.
+ */
+struct clk *spacemit_ccu_get_clk_by_name(const char *name)
+{
+	struct spacemit_ccu *ccu = &spacemit_ccu_k3;
+	struct clk_hw_onecell_data *cells = ccu->clk_cells;
+	struct clk_hw *hw;
+	int i;
+
+	if (!cells || !name)
+		return RT_NULL;
+
+	for (i = 0; i < cells->num; i++) {
+		hw = cells->hws[i];
+		if (hw && hw->init && hw->init->name &&
+		    !rt_strcmp(hw->init->name, name))
+			return clk_hw_get_clk(hw, name);
+	}
+
+	return RT_NULL;
+}
+
+/*
+ * spacemit_ccu_clk_is_enabled - query the hardware enable state of a
+ * registered CCU clock.
+ *
+ * Delegates to the framework clk_get_enabled(): the registered CCU
+ * is_enabled op reads the gate bit back from hardware (e.g. the
+ * CLK_RES_CTRL enable bits) under the enable lock. Used by the RPMI
+ * clock service to report real state instead of assuming enabled.
+ */
+rt_bool_t spacemit_ccu_clk_is_enabled(struct clk *clk)
+{
+	rt_bool_t enabled = RT_FALSE;
+
+	if (!clk)
+		return RT_FALSE;
+
+	/*
+	 * Framework query: registered is_enabled op under the enable
+	 * lock. -RT_ENOSYS (no hardware gate to read) maps to the
+	 * conservative "enabled" so Linux does not re-enable a shared
+	 * parent; anything with a gate is read back from hardware.
+	 * Provider errors also report enabled (fail-safe).
+	 */
+	if (clk_get_enabled(clk, &enabled) == 0)
+		return enabled;
+
+	return RT_TRUE;
+}
