-			ccu->clk_info.rcpu6_base = (void *)dtb_node_get_addr_index(compatible_node, 9);
+			ccu->clk_info.rcpu6_base = (void *)dtb_node_get_addr_index(compatible_node, 10);
 			if (ccu->clk_info.rcpu6_base < 0) {
