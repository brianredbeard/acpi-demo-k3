diff --git a/components/drivers/clk/clk.c b/components/drivers/clk/clk.c
index 2d6494f..951de20 100644
--- a/components/drivers/clk/clk.c
+++ b/components/drivers/clk/clk.c
@@ -358,6 +358,22 @@ const char *clk_hw_get_name(const struct clk_hw *hw)
 	return hw->core->name;
 }
 
+/*
+ * clk_hw_get_ops - fetch the ops of a clk_hw.
+ *
+ * Counterpart of clk_hw_get_name() for the ops: __clk_register() NULLs
+ * hw->init after copying, so the durable ops live in core->ops for a
+ * registered clock and in init->ops before registration. Providers must
+ * use this accessor rather than touching hw->init (gone after
+ * registration) or hw->core (private).
+ */
+const struct clk_ops *clk_hw_get_ops(const struct clk_hw *hw)
+{
+	if (!hw)
+		return NULL;
+	return hw->core ? hw->core->ops : hw->init->ops;
+}
+
 static struct clk_hw *
 __of_clk_get_hw_from_provider(struct of_clk_provider *provider,
                               struct fdt_phandle_args *clkspec)
@@ -2068,6 +2084,65 @@ rt_uint64_t clk_get_rate(struct clk *clk)
 	return rate;
 }
 
+/*
+ * clk_get_enabled - query the hardware enable state of a clock.
+ *
+ * Framework-owned counterpart of clk_get_rate() for gate state. The
+ * registered provider's is_enabled callback is invoked under the
+ * enable lock (it reads a hardware gate bit). Outcomes:
+ *   0            : *enabled reflects the hardware gate state
+ *   -RT_EINVAL   : NULL clk
+ *   -RT_ENOSYS   : this clock has no is_enabled op (no hardware gate
+ *                  to read); the caller decides its policy - a missing
+ *                  callback must NOT silently become "verified enabled"
+ *   provider err : is_enabled failed
+ */
+int clk_get_enabled(struct clk *clk, rt_bool_t *enabled)
+{
+	const struct clk_ops *ops;
+	struct clk_hw *hw;
+	int ret;
+
+	if (!clk || !enabled)
+		return -RT_EINVAL;
+
+	clk_prepare_lock();
+	hw = __clk_get_hw(clk);
+	ops = clk_hw_get_ops(hw);
+	if (!ops || !ops->is_enabled) {
+		clk_prepare_unlock();
+		return -RT_ENOSYS;
+	}
+	ret = ops->is_enabled(hw);
+	clk_prepare_unlock();
+
+	if (ret < 0)
+		return ret;
+	*enabled = ret ? RT_TRUE : RT_FALSE;
+
+	return 0;
+}
+
+/*
+ * clk_has_local_set_rate - capability probe: does this clock implement
+ * a local rate-setting op (divider/mux owner) rather than only gates?
+ *
+ * Reports capability ONLY. It does not establish that a rate change is
+ * safe for shared parents - callers apply their own permission policy
+ * (e.g. the RPMI service only allows rates on clocks whose shared-
+ * parent behavior is qualified).
+ */
+rt_bool_t clk_has_local_set_rate(struct clk *clk)
+{
+	const struct clk_ops *ops;
+
+	if (!clk)
+		return RT_FALSE;
+
+	ops = clk_hw_get_ops(__clk_get_hw(clk));
+	return (ops && ops->set_rate) ? RT_TRUE : RT_FALSE;
+}
+
 static int __clk_set_parent(struct clk_core *core, struct clk_core *parent,
                             unsigned char p_index)
 {
diff --git a/components/drivers/include/drivers/clk-provider.h b/components/drivers/include/drivers/clk-provider.h
index 316601c..e7a7a22 100644
--- a/components/drivers/include/drivers/clk-provider.h
+++ b/components/drivers/include/drivers/clk-provider.h
@@ -447,6 +447,16 @@ struct clk_ops {
 const char *__clk_get_name(const struct clk *clk);
 struct clk_hw *__clk_get_hw(struct clk *clk);
 const char *clk_hw_get_name(const struct clk_hw *hw);
+/*
+ * Framework-owned runtime queries. The provider ops live in the
+ * private clk_core after registration; these are the only public way
+ * to reach them. clk_get_enabled distinguishes enabled/disabled from
+ * unavailable (-RT_ENOSYS: no is_enabled op) and provider errors.
+ * clk_has_local_set_rate is a capability probe only.
+ */
+int clk_get_enabled(struct clk *clk, rt_bool_t *enabled);
+rt_bool_t clk_has_local_set_rate(struct clk *clk);
+const struct clk_ops *clk_hw_get_ops(const struct clk_hw *hw);
 rt_uint64_t clk_hw_get_rate(const struct clk_hw *hw);
 void clk_disable_unprepare(struct clk *clk);
 int clk_prepare_enable(struct clk *clk);
