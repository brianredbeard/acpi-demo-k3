-			ccu->clk_info.rcpu3_base = (void *)dtb_node_get_addr_index(compatible_node, 6);
+			ccu->clk_info.rcpu3_base = (void *)dtb_node_get_addr_index(compatible_node, 7);
 			if (ccu->clk_info.rcpu3_base < 0) {
