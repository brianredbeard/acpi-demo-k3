@@ -997,6 +997,9 @@ int ccu_common_init(struct clk_hw * hw, struct spacemit_k1x_clk *clk_info)
 	case BASE_TYPE_MPMU:
 		common->base = clk_info->mpmu_base;
 		break;
+	case BASE_TYPE_APBC:
