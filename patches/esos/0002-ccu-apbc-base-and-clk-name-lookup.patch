-			ccu->clk_info.rcpu2_base = (void *)dtb_node_get_addr_index(compatible_node, 5);
+			ccu->clk_info.rcpu2_base = (void *)dtb_node_get_addr_index(compatible_node, 6);
 			if (ccu->clk_info.rcpu2_base < 0) {
 				rt_kprintf("get rcpu2 error\n");
