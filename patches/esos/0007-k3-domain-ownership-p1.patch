new file mode 100644
index 000000000..ac5c78dc1
--- /dev/null
+++ b/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.c
@@ -0,0 +1,643 @@
+/*
+ * K3 shared-domain ownership model and retained wake mechanism (P1).
+ * See k3_domain_ownership.h for the design contract.
+ *
+ * Copyright (c) 2026. SPDX-License-Identifier: Apache-2.0
+ * Derived from Spacemit ESOS (Apache-2.0) M2 coordination in
+ * k3-os0_hsm.c / k3-os0_hsm_interface.c.
+ */
+
+#include <rthw.h>
+#include <rtthread.h>
+#include <rtdevice.h>
+#include "../spacemit-rpmi.h"
+#include "k3_hsm.h"
+#include "k3_domain_ownership.h"
+
+static struct k3_cluster_domain k3_domains[K3_MAX_CLUSTERS];
+
+/*
+ * AUDIT-FIXED ACCOUNTING (2026-11-20 review):
+ *  - consumers[] is a per-class REFCOUNT array: multiple users of one
+ *    class each hold a count; one release cannot clear everyone.
+ *  - domains start BLOCKED: the sticky unknown-ownership blocker is
+ *    set at init and cleared only when an ownership provider has
+ *    actually qualified the domain (k3_domain_qualify()).
+ *  - acquiring during ENTERING/COMMITTED invalidates the in-flight
+ *    transaction ATOMICICALLY (generation++ in the same critical
+ *    section that aborts) — a late consumer can never be committed
+ *    over by a request that captured the old generation.
+ *  - request_sleep rechecks generation AND ownership before
+ *    committing.
+ */
+
+/* ---- internal helpers ------------------------------------------------ */
+
+static struct k3_cluster_domain *dom(int cluster)
+{
+	if ((cluster < 0) || (cluster >= K3_MAX_CLUSTERS))
+		return RT_NULL;
+	return &k3_domains[cluster];
+}
+
+static rt_uint32_t class_bit(enum k3_consumer_class c)
+{
+	return (rt_uint32_t)1U << (c & 0x1f);
+}
+
+/* Cluster sleep is eligible only when EVERY consumer class is fully
+ * released and the domain has been qualified by an ownership provider.
+ * Unknown ownership is sticky: it blocks until explicitly cleared. */
+int k3_domain_consumer_acquire(int cluster, enum k3_consumer_class c)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+	int ret = 0;
+
+	if (!d)
+		return -RT_EINVAL;
+
+	if ((c >= K3_CONSUMER_CLASS_COUNT) || (c == K3_CONSUMER_UNKNOWN))
+		return -RT_EINVAL;	/* unknown ownership is a blocker */
+
+	level = rt_hw_interrupt_disable();
+	if (d->state != K3_DOMAIN_ACTIVE) {
+		/* Acquiring a consumer while entering/committed must
+		 * INVALIDATE the in-flight transaction: the generation
+		 * bumps in the SAME critical section as the abort, so a
+		 * request that later compares generations cannot miss
+		 * this consumer and commit over it (audit finding 2). */
+		if ((d->state == K3_DOMAIN_ENTERING) ||
+		    (d->state == K3_DOMAIN_COMMITTED)) {
+			d->generation++;	/* atomic invalidation */
+			d->state = K3_DOMAIN_ABORTED;
+			d->stats.aborted_entry++;
+			ret = 1;	/* entry aborted; caller retries */
+		} else {
+			ret = -RT_EBUSY;	/* asleep/restoring: wait */
+		}
+	}
+	d->consumers[c]++;
+	rt_hw_interrupt_enable(level);
+
+	/*
+	 * Normalize the transient ABORTED state outside the lock: the
+	 * invalidation already happened (generation++ + state change
+	 * atomically); abort_sleep records the stats and returns the
+	 * domain to ACTIVE so new requests are admitted.
+	 */
+	if (ret == 1)
+		k3_domain_abort_sleep(cluster);
+
+	return (ret < 0) ? ret : 0;
+}
+
+int k3_domain_consumer_release(int cluster, enum k3_consumer_class c)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return -RT_EINVAL;
+	if (c >= K3_CONSUMER_CLASS_COUNT)
+		return -RT_EINVAL;
+
+	level = rt_hw_interrupt_disable();
+	if (d->consumers[c])
+		d->consumers[c]--;
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+/*
+ * Domain qualification: an ownership provider that has actually
+ * enumerated this cluster's consumers clears the sticky blocker.
+ * Before this call the domain is BLOCKED (audit finding 3: init
+ * must not start sleep-eligible by default).
+ */
+/*
+ * Bounded-handshake failure accounting (audit fix 4): the M2-enter
+ * ISR could not clear the hardware pending bit within its budget.
+ * Retained counter only — no serial I/O in the transition path.
+ */
+void k3_domain_note_hw_timeout(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+
+	if (!d)
+		return;
+	d->stats.hw_handshake_timeouts++;
+}
+
+int k3_domain_qualify(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return -RT_EINVAL;
+
+	level = rt_hw_interrupt_disable();
+	d->qualified = 1;
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+/*
+ * ---- domain sequencing (P1: qualified domain sequencing) ----------
+ *
+ * The ordered cluster-M2 entry, executed ENTIRELY on the management
+ * core. The AP never places cluster votes (v21f hardware finding: a
+ * single hart voting cluster power on a busy cluster corrupts
+ * memory); the cores vote THEMSELVES down via their own hart-stop
+ * path, and this side only OBSERVES those votes and authorizes M2.
+ *
+ * Ordering (each step reversible at its documented failure point):
+ *   QUIESCE  state=COMMITTED — the suspend-prepare gate denies new
+ *            work for the cluster (enforced by the state machine)
+ *   ENABLE   clusterx_m2_lp_ctrl.rcpu_ctrl_clx_m2_lp_en = 1
+ *   WAIT     bounded on the M2-enter semaphore (the ISR transitions
+ *            the domain to ASLEEP on the hardware's own signal)
+ *   ABORT    on timeout: clear ENABLE; the cores own their votes, so
+ *            nothing else is unwound; state returns ACTIVE
+ *
+ * Hardware hooks are injected through k3_domain_hw_ops so the model
+ * stays testable on the host (fault injection at every step).
+ */
+const struct k3_domain_hw_ops k3_domain_hw_nops = {
+	.m2_enable = 0,
+	.m2_disable = 0,
+	.cores_all_stopped = 0,
+};
+
+static const struct k3_domain_hw_ops *hw_ops = &k3_domain_hw_nops;
+
+void k3_domain_set_hw_ops(const struct k3_domain_hw_ops *ops)
+{
+	if (ops)
+		hw_ops = ops;
+	else
+		hw_ops = &k3_domain_hw_nops;
+}
+
+int k3_domain_commit_sleep(int cluster, int timeout_ms)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+	rt_err_t wait;
+
+	if (!d)
+		return -RT_EINVAL;
+
+	level = rt_hw_interrupt_disable();
+	if (d->state != K3_DOMAIN_ACTIVE) {
+		rt_hw_interrupt_enable(level);
+		return -RT_EBUSY;
+	}
+	/* QUIESCE: the state change itself — the prepare gate and the
+	 * eligibility check deny new work from this point */
+	d->state = K3_DOMAIN_ENTERING_WAIT;
+	rt_hw_interrupt_enable(level);
+
+	/* ENABLE: authorize the cluster M2 (rcpu-controlled) */
+	if (hw_ops->m2_enable && hw_ops->m2_enable(cluster)) {
+		level = rt_hw_interrupt_disable();
+		d->state = K3_DOMAIN_ACTIVE;
+		d->stats.aborted_entry++;
+		rt_hw_interrupt_enable(level);
+		return -RT_EIO;
+	}
+
+	/* WAIT (bounded): the hardware M2-enter interrupt drives ASLEEP */
+	wait = rt_sem_take(d->m2_enter_sem,
+			   timeout_ms > 0 ?
+			   rt_tick_from_millisecond(timeout_ms) :
+			   RT_WAITING_NO);
+	if (wait != RT_EOK) {
+		/* ABORT: clear the enable; the cores own their votes */
+		if (hw_ops->m2_disable)
+			hw_ops->m2_disable(cluster);
+		level = rt_hw_interrupt_disable();
+		d->state = K3_DOMAIN_ACTIVE;
+		d->stats.aborted_entry++;
+		rt_hw_interrupt_enable(level);
+		return -RT_ETIMEOUT;
+	}
+
+	level = rt_hw_interrupt_disable();
+	if (d->state != K3_DOMAIN_ENTERING_WAIT) {
+		/* unexpected state at wake (e.g. an abort raced): undo */
+		rt_hw_interrupt_enable(level);
+		if (hw_ops->m2_disable)
+			hw_ops->m2_disable(cluster);
+		k3_domain_abort_sleep(cluster);
+		return -RT_EINTR;
+	}
+	d->state = K3_DOMAIN_ASLEEP;
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+/*
+ * Core-state observation: the AP cores vote themselves down through
+ * their own hart-stop path (per-core IDLE_CFG pwrdwn bits in the
+ * PMU). The provider releases the cluster's X100_AP ownership when
+ * every core is observed stopped, and re-acquires on any wake.
+ */
+rt_bool_t k3_domain_cluster_quiesced(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_bool_t quiesced;
+	int i;
+
+	if (!d)
+		return RT_FALSE;
+
+	quiesced = d->qualified && (d->state == K3_DOMAIN_ACTIVE);
+	if (quiesced)
+		for (i = 0; i < K3_CONSUMER_CLASS_COUNT; i++)
+			if (d->consumers[i])
+				quiesced = RT_FALSE;
+	if (!quiesced)
+		return RT_FALSE;
+
+	if (!hw_ops->cores_all_stopped)
+		return RT_FALSE;	/* unmanaged cluster: never quiesced */
+
+	return hw_ops->cores_all_stopped(cluster);
+}
+
+/*
+ * Provider dynamics for the X100_AP class: release when the whole
+ * cluster is observed stopped; re-acquire on wake. Returns 1 when
+ * the release happened.
+ */
+int k3_domain_provider_release(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return -RT_EINVAL;
+	if (!k3_domain_cluster_quiesced(cluster))
+		return 0;
+
+	level = rt_hw_interrupt_disable();
+	if (d->consumers[K3_CONSUMER_X100_AP])
+		d->consumers[K3_CONSUMER_X100_AP]--;
+	rt_hw_interrupt_enable(level);
+	return 1;
+}
+
+int k3_domain_provider_reacquire(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return -RT_EINVAL;
+
+	level = rt_hw_interrupt_disable();
+	d->consumers[K3_CONSUMER_X100_AP]++;
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+rt_bool_t k3_domain_sleep_eligible(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_bool_t eligible;
+
+	if (!d)
+		return RT_FALSE;
+
+	/* Sticky unqualified blocker + any active consumer count blocks
+	 * sleep. The management core (K3_CONSUMER_MGMT) itself must be
+	 * released before the cluster it manages sleeps. */
+	eligible = d->qualified &&
+		   (d->state == K3_DOMAIN_ACTIVE);
+	if (eligible) {
+		for (int i = 0; i < K3_CONSUMER_CLASS_COUNT; i++)
+			if (d->consumers[i]) {
+				eligible = RT_FALSE;
+				break;
+			}
+	}
+	return eligible;
+}
+
+/* ---- state machine --------------------------------------------------- */
+
+/*
+ * Request sleep for a cluster. BOUNDED wait: the M2-enter hardware
+ * handshake (spacemit_cx_m2_enter_wait's spin loop is replaced by a
+ * semaphore + timeout). On timeout the entry ABORTS: no vote survives,
+ * the cluster stays runnable.
+ */
+int k3_domain_request_sleep(int cluster, int timeout_ms)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+	rt_err_t wait;
+	rt_uint32_t my_generation;
+
+	if (!d)
+		return -RT_EINVAL;
+
+	level = rt_hw_interrupt_disable();
+	if (d->state != K3_DOMAIN_ACTIVE) {
+		rt_hw_interrupt_enable(level);
+		return -RT_EBUSY;
+	}
+	/*
+	 * AUDIT FIX: use the eligibility rules (qualified + zero
+	 * per-class refcounts), not a scalar bitmask remnant. The
+	 * old `consumers != 0` read the refcount ARRAY as a pointer
+	 * after the accounting change — always-true, always deny.
+	 */
+	{
+		rt_bool_t eligible = d->qualified;
+		int i;
+
+		for (i = 0; i < K3_CONSUMER_CLASS_COUNT; i++)
+			if (d->consumers[i])
+				eligible = RT_FALSE;
+		if (!eligible) {
+			rt_hw_interrupt_enable(level);
+			return -RT_ERROR;	/* unqualified or consumers active */
+		}
+	}
+
+	d->state = K3_DOMAIN_ENTERING;
+	d->generation++;
+	my_generation = d->generation;
+	rt_hw_interrupt_enable(level);
+
+	/*
+	 * HARDWARE-VALIDATED FIX (v21g cycle): drain any STALE
+	 * semaphore count before waiting. A boot-time or leftover
+	 * M2-enter interrupt release pre-arms m2_enter_sem; without
+	 * the drain, the first request after boot is granted
+	 * instantly (v21g test 1: grant with the cluster busy).
+	 * The drain discards stale signals so only an M2-enter that
+	 * lands DURING this wait can grant the transaction.
+	 */
+	while (rt_sem_take(d->m2_enter_sem, RT_WAITING_NO) == RT_EOK)
+		d->stats.stale_vote_rejected++;
+
+	/* Bounded wait for the hardware M2-enter handshake. The ISR
+	 * releases m2_enter_sem when the cluster's M2 request lands. */
+	if (timeout_ms > 0) {
+		wait = rt_sem_take(d->m2_enter_sem,
+				   rt_tick_from_millisecond(timeout_ms));
+		if (wait != RT_EOK) {
+			/* timeout: abort, no vote survives */
+			k3_domain_abort_sleep(cluster);
+			return -RT_ETIMEOUT;
+		}
+	} else if (timeout_ms == 0) {
+		/* non-blocking poll */
+		wait = rt_sem_take(d->m2_enter_sem, RT_WAITING_NO);
+		if (wait != RT_EOK) {
+			k3_domain_abort_sleep(cluster);
+			return -RT_ETIMEOUT;
+		}
+	}
+
+	level = rt_hw_interrupt_disable();
+	if (d->generation != my_generation) {
+		/* stale transaction (a newer request/abort won): undo */
+		rt_hw_interrupt_enable(level);
+		d->stats.stale_vote_rejected++;
+		return -RT_EINTR;
+	}
+	/*
+	 * AUDIT FIX 2: recheck OWNERSHIP before committing — the
+	 * generation guards transaction ordering, but a consumer may
+	 * have arrived and been refused (not aborting this request)
+	 * or the qualifier state may have changed. Commit only when
+	 * both the transaction is current AND no consumer holds the
+	 * domain (fall back to the same eligibility rules).
+	 */
+	{
+		rt_bool_t still_eligible = d->qualified;
+		for (int i = 0; i < K3_CONSUMER_CLASS_COUNT; i++)
+			if (d->consumers[i])
+				still_eligible = RT_FALSE;
+		if (!still_eligible) {
+			rt_hw_interrupt_enable(level);
+			d->state = K3_DOMAIN_ABORTED;
+			d->stats.aborted_entry++;
+			return -RT_EINTR;
+		}
+	}
+	d->state = K3_DOMAIN_COMMITTED;
+	rt_hw_interrupt_enable(level);
+
+	/* COMMITTED: the actual power-down ordering (L2 flush, isolation,
+	 * votes) is deliberately NOT implemented here — it lands only
+	 * after this model plus the wake mechanism are hardware-qualified
+	 * per the plan. Until then COMMITTED immediately transitions to
+	 * ASLEEP only when the hardware reports the M2 state, driven by
+	 * the M2-enter ISR. */
+	return 0;
+}
+
+int k3_domain_abort_sleep(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return -RT_EINVAL;
+
+	level = rt_hw_interrupt_disable();
+	if ((d->state == K3_DOMAIN_ENTERING) ||
+	    (d->state == K3_DOMAIN_COMMITTED)) {
+		d->stats.aborted_entry++;
+		/* votes: the OpenSBI side owns vote placement; this side
+		 * only guarantees the state prevents a stale commit. The
+		 * generation bump invalidates in-flight transactions. */
+		d->generation++;
+	}
+	/* ABORTED is transient: no hardware change happened on this side,
+	 * so the cluster returns to ACTIVE immediately. A COMMITTED abort
+	 * additionally requires the OpenSBI-side vote cleanup (its own
+	 * contract); the generation bump guarantees a stale commit from
+	 * the old transaction is rejected when it lands. */
+	if (d->state != K3_DOMAIN_ASLEEP)
+		d->state = K3_DOMAIN_ACTIVE;
+	rt_hw_interrupt_enable(level);
+
+	return 0;
+}
+
+int k3_domain_note_wake(int cluster, enum k3_consumer_class source)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return -RT_EINVAL;
+
+	level = rt_hw_interrupt_disable();
+	switch (source) {
+	case K3_CONSUMER_MGMT:
+		d->stats.wake_ipc++;
+		break;
+	case K3_CONSUMER_DMA:
+		d->stats.wake_timer++;	/* timer deadline routed via mgmt */
+		break;
+	default:
+		d->stats.wake_other++;
+		break;
+	}
+	if (d->state == K3_DOMAIN_ASLEEP) {
+		d->state = K3_DOMAIN_RESTORING;
+		rt_sem_release(d->m2_exit_sem);
+	}
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+/* ---- M2 hardware hooks ------------------------------------------------ */
+
+/*
+ * Called from the existing AP_Cx_M2_ENTER interrupt handler. The
+ * hardware contract (clusterx_m2_lp_ctrl bit 2 handshake in
+ * spacemit_cx_m2_enter_wait) is preserved; this adds the state
+ * accounting and the semaphore that replaces the unbounded spin.
+ */
+void k3_domain_m2_enter_isr(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return;
+
+	d->stats.m2_enter_count++;
+
+	level = rt_hw_interrupt_disable();
+	if (d->state == K3_DOMAIN_ENTERING_WAIT) {
+		/*
+		 * The hardware M2-enter for a commit_sleep in flight:
+		 * wake the sequencer (its bounded take returns) — the
+		 * ASLEEP transition happens under the sequencer's own
+		 * state check, keeping a single owner of the commit.
+		 */
+		rt_hw_interrupt_enable(level);
+		rt_sem_release(d->m2_enter_sem);
+		return;
+	}
+	if (d->state == K3_DOMAIN_ENTERING) {
+		/* legacy request path: the direct transition stays */
+		d->hw_mp_state = 0;	/* observed on entry */
+		d->state = K3_DOMAIN_ASLEEP;
+	}
+	rt_hw_interrupt_enable(level);
+
+	rt_sem_release(d->m2_enter_sem);
+}
+
+/*
+ * Called from the existing AP_Cx_M2_EXIT handler (the wake path:
+ * spacemit_assert_corex + spacemit_cx_m2_int_disabled). The hardware
+ * wake sequence stays as-is; this restores the state machine so new
+ * requests can proceed.
+ */
+void k3_domain_m2_exit_isr(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	rt_base_t level;
+
+	if (!d)
+		return;
+
+	d->stats.m2_exit_count++;
+
+	/* WAKE RESTORE: the rcpu-side M2 authorization clears first */
+	if (hw_ops->m2_disable)
+		hw_ops->m2_disable(cluster);
+
+	level = rt_hw_interrupt_disable();
+	if ((d->state == K3_DOMAIN_ASLEEP) ||
+	    (d->state == K3_DOMAIN_COMMITTED) ||
+	    (d->state == K3_DOMAIN_ENTERING_WAIT) ||
+	    (d->state == K3_DOMAIN_RESTORING)) {
+		d->state = K3_DOMAIN_ACTIVE;
+		/*
+		 * Provider re-acquire: any core waking re-opens the
+		 * cluster to AP ownership. The count is re-held by the
+		 * provider (the class contract: one aggregate owner).
+		 */
+		d->consumers[K3_CONSUMER_X100_AP]++;
+	}
+	rt_hw_interrupt_enable(level);
+
+	rt_sem_release(d->m2_exit_sem);
+}
+
+/* ---- init ------------------------------------------------------------- */
+
+int k3_domain_init(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	char name[16];
+
+	if (!d)
+		return -RT_EINVAL;
+	if (d->m2_enter_sem)
+		return 0;	/* idempotent */
+
+	rt_snprintf(name, sizeof(name), "k3d%d_in", cluster);
+	d->m2_enter_sem = rt_sem_create(name, 0, RT_IPC_FLAG_FIFO);
+	if (!d->m2_enter_sem)
+		return -RT_ENOMEM;
+
+	rt_snprintf(name, sizeof(name), "k3d%d_out", cluster);
+	d->m2_exit_sem = rt_sem_create(name, 0, RT_IPC_FLAG_FIFO);
+	if (!d->m2_exit_sem) {
+		rt_sem_delete(d->m2_enter_sem);
+		d->m2_enter_sem = RT_NULL;
+		return -RT_ENOMEM;
+	}
+
+	/*
+	 * AUDIT FIX 3: start BLOCKED. The domain is sleep-ineligible
+	 * until k3_domain_qualify() runs (an ownership provider has
+	 * enumerated the consumers). consumers[] refcounts start at
+	 * zero; qualification — not emptiness — is what admits sleep.
+	 */
+	d->state = K3_DOMAIN_ACTIVE;
+	for (int i = 0; i < K3_CONSUMER_CLASS_COUNT; i++)
+		d->consumers[i] = 0;
+	d->qualified = 0;
+	d->generation = 0;
+	rt_memset(&d->stats, 0, sizeof(d->stats));
+	return 0;
+}
+
+#ifdef K3_DOMAIN_TEST
+/* Test hook: simulate ONLY the semaphore release of the M2-enter ISR
+ * (the full ISR drives state too; tests use this to deliver a
+ * legitimate grant mid-wait). */
+void k3_domain_m2_enter_release(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+
+	if (d && d->m2_enter_sem)
+		rt_sem_release(d->m2_enter_sem);
+}
+
+/* Test hook: direct domain access for state/stat assertions. */
+struct k3_cluster_domain *k3_test_domain(int cluster) { return dom(cluster); }
+
+/* Test hook: prime the M2-enter semaphore so a bounded request succeeds. */
+void k3_domain_test_prime_enter(int cluster)
+{
+	struct k3_cluster_domain *d = dom(cluster);
+	if (d && d->m2_enter_sem)
+		rt_sem_release(d->m2_enter_sem);
+}
+#endif
diff --git a/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.h b/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.h
new file mode 100644
index 000000000..7d0435ccd
--- /dev/null
+++ b/bsp/spacemit/drivers/rpmi/k3/k3_domain_ownership.h
@@ -0,0 +1,161 @@
+/*
+ * K3 shared-domain ownership model and retained wake mechanism (P1).
+ *
+ * Design per the suspend-ownership plan:
+ *   - OpenSBI owns the hart's architectural suspend/resume contract
+ *     (register operations executing on the affected hart).
+ *   - ESOS owns shared-resource ELIGIBILITY and hardware coordination:
+ *     whether a cluster/domain may power down, and how a sleeping
+ *     cluster is woken.
+ *
+ * Scope of this first implementation:
+ *   P1-a Explicit resource ownership: per-cluster consumer tracking.
+ *     Unknown ownership is a BLOCKER (conservative).
+ *   P1-b Shared-domain state machine: active / entering / committed /
+ *     asleep / restoring / aborted with single-owner transitions.
+ *   P1-c Transactional power votes: requests carry a generation number;
+ *     stale or duplicate requests cannot leave a domain eligible.
+ *   P1-d Retained wake mechanism: the M2 interrupt path (already the
+ *     hardware contract: AP_Cx_M2_ENTER/EXIT interrupts, clusterx_m2_lp_ctrl
+ *     registers, AUDIO_WAKEUP_EN_REG) is wired to the state machine with
+ *     BOUNDED waits; a timeout aborts entry and leaves the cluster
+ *     runnable with no stale vote.
+ *
+ * Deliberately NOT implemented here (per plan): cluster shutdown itself.
+ * The model gates it; when every consumer is accounted for and the wake
+ * mechanism is qualified, the actual power sequence goes through
+ * k3_domain_commit_sleep() with the documented ordering hooks.
+ *
+ * Diagnostics (supporting deliverable): retained per-cluster counters —
+ * requests, aborts, wake reasons, state transitions — readable via
+ * debugger; NO serial logging in the transition path.
+ */
+
+#ifndef K3_DOMAIN_OWNERSHIP_H
+#define K3_DOMAIN_OWNERSHIP_H
+
+#include <rthw.h>
+#include <rtthread.h>
+
+/* ---- cluster/domains ------------------------------------------------ */
+
+#define K3_MAX_CLUSTERS		4	/* C0..C3 (X100: C0/C1 only) */
+
+/*
+ * Shared-domain states. Transitions are single-owner (the ESOS management
+ * core serializes through the cluster lock):
+ *
+ *   ACTIVE -> ENTERING -> COMMITTED -> ASLEEP -> RESTORING -> ACTIVE
+ *        \              \
+ *         \              -> ABORTED -> ACTIVE (no vote survives)
+ *         -> ABORTED -> ACTIVE
+ *
+ * ENTERING: votes are being placed; a late consumer or a timeout aborts.
+ * COMMITTED: the power-down decision is final; wake is the only exit.
+ * ASLEEP: hardware MP state confirms the cluster is in M2.
+ * RESTORING: the M2-EXIT path is waking the cluster; new requests wait.
+ */
+enum k3_domain_state {
+	K3_DOMAIN_ACTIVE = 0,
+	K3_DOMAIN_ENTERING,
+	K3_DOMAIN_COMMITTED,
+	K3_DOMAIN_ENTERING_WAIT,	/* commit_sleep waiting on the M2 enter */
+	K3_DOMAIN_ASLEEP,
+	K3_DOMAIN_RESTORING,
+	K3_DOMAIN_ABORTED,
+};
+
+/* Consumer classes for ownership accounting. Unknown = blocker. */
+enum k3_consumer_class {
+	K3_CONSUMER_X100_AP	= 0,	/* application cores in this cluster */
+	K3_CONSUMER_A100	= 1,	/* accelerator cores (harts 8-15) */
+	K3_CONSUMER_GPU		= 2,
+	K3_CONSUMER_DISPLAY	= 3,
+	K3_CONSUMER_DMA		= 4,
+	K3_CONSUMER_MGMT	= 5,	/* ESOS/management itself */
+	K3_CONSUMER_CLASS_COUNT,
+	K3_CONSUMER_UNKNOWN	= 0xff,	/* blocker: unaccounted activity */
+};
+
+struct k3_wake_stats {
+	rt_uint32_t m2_enter_count;
+	rt_uint32_t m2_exit_count;
+	rt_uint32_t wake_ipc;
+	rt_uint32_t wake_timer;
+	rt_uint32_t wake_other;
+	rt_uint32_t aborted_entry;
+	rt_uint32_t stale_vote_rejected;
+	rt_uint32_t hw_handshake_timeouts;	/* audit fix 4 */
+};
+
+struct k3_cluster_domain {
+	/* state machine (protected by lock) */
+	enum k3_domain_state	state;
+	rt_uint32_t		generation;	/* vote transaction id */
+	rt_base_t		lock;
+
+	/* ownership: per-class consumer REFCOUNTS (one release cannot
+	 * clear another user of the same class) + the qualification
+	 * gate (a domain starts BLOCKED until a provider qualifies it) */
+	rt_uint16_t		consumers[K3_CONSUMER_CLASS_COUNT];
+	rt_uint8_t		qualified;
+
+	/* entry coordination */
+	rt_sem_t		m2_enter_sem;	/* AP requested entry */
+	rt_sem_t		m2_exit_sem;	/* cluster exited M2 */
+	rt_uint32_t		hw_mp_state;	/* last observed clx_mp_state */
+
+	/* retained diagnostics (debugger-readable; no serial I/O) */
+	struct k3_wake_stats	stats;
+};
+
+/*
+ * Ownership API. All return 0 on success, negative errno on failure.
+ * Unknown ownership BLOCKS sleep: k3_domain_consumer_acquire() with
+ * K3_CONSUMER_UNKNOWN returns -RT_EINVAL and marks the cluster
+ * permanently active until explicitly cleared.
+ */
+int k3_domain_consumer_acquire(int cluster, enum k3_consumer_class c);
+int k3_domain_consumer_release(int cluster, enum k3_consumer_class c);
+rt_bool_t k3_domain_sleep_eligible(int cluster);
+
+/* Domain qualification: clears the sticky unqualified blocker once an
+ * ownership provider has actually enumerated this cluster's consumers. */
+int k3_domain_qualify(int cluster);
+
+/* Retained-counter hook for a bounded M2 handshake timeout in the ISR. */
+void k3_domain_note_hw_timeout(int cluster);
+/*
+ * Hardware operations injected into the domain sequencer (host tests
+ * inject faults here; the rcpu registers the PMU/M2 implementations).
+ */
+struct k3_domain_hw_ops {
+	int (*m2_enable)(int cluster);
+	int (*m2_disable)(int cluster);
+	rt_bool_t (*cores_all_stopped)(int cluster);
+};
+extern const struct k3_domain_hw_ops k3_domain_hw_nops;
+void k3_domain_set_hw_ops(const struct k3_domain_hw_ops *ops);
+
+/* Domain sequencing (P1): the ordered, abortable cluster-M2 entry. */
+int k3_domain_commit_sleep(int cluster, int timeout_ms);
+rt_bool_t k3_domain_cluster_quiesced(int cluster);
+int k3_domain_provider_release(int cluster);
+int k3_domain_provider_reacquire(int cluster);
+
+/*
+ * State machine + wake. Bounded waits only: timeout_ms <= 0 means
+ * non-blocking poll. Entry abort leaves the cluster ACTIVE with no vote.
+ */
+int k3_domain_request_sleep(int cluster, int timeout_ms);
+int k3_domain_abort_sleep(int cluster);
+int k3_domain_note_wake(int cluster, enum k3_consumer_class source);
+
+/* M2 hardware hooks (called from the existing IRQ handlers). */
+void k3_domain_m2_enter_isr(int cluster);
+void k3_domain_m2_exit_isr(int cluster);
+
+/* One-time init per cluster (idempotent). */
+int k3_domain_init(int cluster);
+
+#endif /* K3_DOMAIN_OWNERSHIP_H */
diff --git a/bsp/spacemit/platform/rt24/k3.dtsi b/bsp/spacemit/platform/rt24/k3.dtsi
index 0ec46bce9..4102e4164 100644
--- a/bsp/spacemit/platform/rt24/k3.dtsi
+++ b/bsp/spacemit/platform/rt24/k3.dtsi
@@ -785,6 +785,25 @@
 					min-residency-us = <2700>;
 					wakeup-latency-us = <1500>;
 				};
+
+				/*
+				 * Cluster-RETENTIVE (P1 activation): routed by
+				 * OpenSBI through RPMI_HSM_SRV_HART_SUSPEND so
+				 * the ESOS ownership gate drives the cluster M2
+				 * decision. The hart retains full architectural
+				 * state (no local-timer-stop: the timer keeps
+				 * running and is a wake source). Latencies TBD —
+				 * placeholder vendor values until measured.
+				 */
+				CLUSTER_RET: cluster-retentive@18 {
+					compatible = "riscv,idle-state";
+					reg = <0x0 0x0>;
+					riscv,sbi-suspend-param = <0x11000000>;
+					entry-latency-us = <600>;
+					exit-latency-us = <1100>;
+					min-residency-us = <2700>;
+					wakeup-latency-us = <1500>;
+				};
 			};
 
 			rpmi_sysreset0: rpmi-sysreset@18 {
