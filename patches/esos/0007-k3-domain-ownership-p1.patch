+/*
+ * ---- rcpu hardware ops for the domain sequencer -------------------
+ *
+ * PMU/M2 register implementations injected into k3_domain_commit_sleep
+ * (the model itself stays host-testable). Register contract:
+ *   m2_enable/disable : clusterx_m2_lp_ctrl bit0 (rcpu_ctrl_clx_m2_lp_en)
+ *   cores_all_stopped : every core of the cluster has its IDLE_CFG
+ *                       pwrdwn vote set (the cores vote themselves via
+ *                       their own hart-stop path; this only READS)
+ */
+static volatile unsigned int *clx_m2_ctl(rpmi_uint32_t cluster_id)
+{
+	switch (cluster_id) {
+	case 0: return (volatile unsigned int *)AP_C0_M2_INT_EN_REG;
+	case 1: return (volatile unsigned int *)AP_C1_M2_INT_EN_REG;
+	case 2: return (volatile unsigned int *)AP_C2_M2_INT_EN_REG;
+	case 3: return (volatile unsigned int *)AP_C3_M2_INT_EN_REG;
+	default: return RT_NULL;
+	}
+}
+
+/* per-core IDLE_CFG (the AP-side vote registers, rcpu-readable) */
+static volatile unsigned int *core_idle_cfg(rpmi_uint32_t hart_index)
+{
+	/*
+	 * PMU_CAP_COREx_IDLE_CFG — the authoritative map from the AP-side
+	 * vote function (k3.h): cores 0-3 = cluster 0, cores 4-7 = cluster 1.
+	 * This only READS the votes the cores place via their own hart-stop
+	 * path; the rcpu never writes these registers.
+	 */
+	static const rt_uint32_t base[8] = {
+		0xD4282800 + 0x124, 0xD4282800 + 0x128,	/* C0: core0,1 */
+		0xD4282800 + 0x160, 0xD4282800 + 0x164,	/* C0: core2,3 */
+		0xD4282800 + 0x304, 0xD4282800 + 0x308,	/* C1: core4,5 */
+		0xD4282800 + 0x30C, 0xD4282800 + 0x310,	/* C1: core6,7 */
+	};
+
+	if (hart_index >= 8)
+		return RT_NULL;
+	return (volatile unsigned int *)base[hart_index];
+}
+
+static int k3_ops_m2_enable(int cluster)
+{
+	volatile unsigned int *ctl = clx_m2_ctl(cluster);
+	unsigned int v;
+
+	if (!ctl)
+		return -1;
+	v = readl((unsigned int *)ctl);
+	v |= (1 << 0);
+	writel(v, (unsigned int *)ctl);
+	return 0;
+}
+
+static int k3_ops_m2_disable(int cluster)
+{
+	volatile unsigned int *ctl = clx_m2_ctl(cluster);
+	unsigned int v;
+
+	if (!ctl)
+		return -1;
+	v = readl((unsigned int *)ctl);
+	v &= ~(1U << 0);
+	writel(v, (unsigned int *)ctl);
+	return 0;
+}
+
+static rt_bool_t k3_ops_cores_all_stopped(int cluster)
+{
+	int i;
+
+	/* X100 clusters: cores 0-3 (C0), 4-7 (C1) */
+	for (i = cluster * 4; i < (cluster + 1) * 4; i++) {
+		volatile unsigned int *cfg = core_idle_cfg(i);
+		unsigned int v;
+
+		if (!cfg)
+			return RT_FALSE;
+		v = readl((unsigned int *)cfg);
+		if (!(v & 0x2))		/* core_pwrdwn bit */
+			return RT_FALSE;
+	}
+	return RT_TRUE;
+}
+
+static const struct k3_domain_hw_ops k3_hsm_domain_hw_ops = {
+	.m2_enable = k3_ops_m2_enable,
+	.m2_disable = k3_ops_m2_disable,
+	.cores_all_stopped = k3_ops_cores_all_stopped,
+};
+
