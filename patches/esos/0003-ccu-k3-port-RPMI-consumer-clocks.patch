From 52a293970f91c86ec0af8fc879b1c94f93119461 Mon Sep 17 00:00:00 2001
From: Brian 'redbeard' Harrington <redbeard@dead-city.org>
Date: Thu, 19 Nov 2026 17:33:47 -0800
Subject: [PATCH] clk: ccu-k3: port RPMI consumer clocks to the AP domains

Port the consumer-relevant subset of Linux ccu-k3.c clock definitions
into the ESOS CCU so RPMI CLOCK ids 1-12 (k3-rpmi-clk-ids.h) resolve
to real clocks: apb_clk/axi_clk parents, pll2_d6/pll2_d8, twsi0
func+bus, gpio func+bus, sdh0 + sdh_axi_aclk, usb2_bus, ufs_aclk +
ufs_refclk, emac0 bus/ref/rgmii_tx. Register offsets and gate/mux/div
bit layouts mirror Linux include/soc/spacemit/k3-syscon.h and
drivers/clk/spacemit/ccu-k3.c so enable/readback state matches the
kernel CCU driver; clock names match the RPMI ABI exactly.

Clock IDs 162-177 are appended to the rt24 ID header (append-only).
---
 bsp/spacemit/drivers/clk/ccu-spacemit-k3.c    | 127 ++++++++++++++++++
 bsp/spacemit/drivers/clk/ccu-spacemit-k3.h    |  17 +++
 bsp/spacemit/platform/rt24/ccu-spacemit-k3.h  |  23 +++-
 .../drivers/include/drivers/clk-provider.h    |   6 +-
 4 files changed, 171 insertions(+), 2 deletions(-)

diff --git a/bsp/spacemit/drivers/clk/ccu-spacemit-k3.c b/bsp/spacemit/drivers/clk/ccu-spacemit-k3.c
index b01af56f3..20a95d306 100644
--- a/bsp/spacemit/drivers/clk/ccu-spacemit-k3.c
+++ b/bsp/spacemit/drivers/clk/ccu-spacemit-k3.c
@@ -115,6 +115,14 @@ static SPACEMIT_CCU_FACTOR(pll2_20, "pll2_20", "pll2_d5", 30, 1);
 //pll2_d3
 static SPACEMIT_CCU_FACTOR(pll2_d24_125, "pll2_d24_125", "pll2_d3", 8, 1);
 static SPACEMIT_CCU_FACTOR(pll2_d120_25, "pll2_d120_25", "pll2_d3", 40, 1);
+static SPACEMIT_CCU_GATE_FACTOR(pll2_d6, "pll2_d6", "pll2",
+	BASE_TYPE_APBS, APBS_PLL2_SWCR2,
+	BIT(5), BIT(5), 0x0,
+	6, 1, 0);
+static SPACEMIT_CCU_GATE_FACTOR(pll2_d8, "pll2_d8", "pll2",
+	BASE_TYPE_APBS, APBS_PLL2_SWCR2,
+	BIT(7), BIT(7), 0x0,
+	8, 1, 0);
 
 //pll6_d5
 static SPACEMIT_CCU_FACTOR(pll6_80, "pll6_80", "pll6_d5", 8, 1);
@@ -786,6 +794,108 @@ static SPACEMIT_CCU_GATE_NO_PARENT(rpwm9_rst, "rpwm9_rst", NULL,
 	BASE_TYPE_RCPU6, RCPU6_PWM9_CLK_RST,
 	BIT(2) | BIT(0), BIT(0), BIT(2), 0 );
 
+
+/*
+ * Application-core (AP) clock domain: clocks consumed by Linux drivers
+ * under ACPI via the RPMI CLOCK service (MPXY channel 8). Names must
+ * match k3-rpmi-clk-ids.h exactly (they are the RPMI ABI served to
+ * clk-rpmi as con_ids) and register/bit semantics mirror Linux
+ * drivers/clk/spacemit/ccu-k3.c so enable/readback state agrees with
+ * the kernel CCU driver.
+ */
+
+/* MPMU APBCSCR: AP bus clock source mux (pll1_d96_25p6/51p2/102p4) */
+static const char * const apb_parents[] = {
+	"pll1_d96_25p6", "pll1_d48_51p2", "pll1_d96_25p6", "pll1_d24_102p4"
+};
+static SPACEMIT_CCU_MUX(apb_clk, "apb_clk", apb_parents,
+	BASE_TYPE_MPMU, MPMU_APBCSCR,
+	0, 2,
+	0);
+
+/* APMU ACLK: AXI bus mux + divider feeding all APMU bus gates */
+static const char * const axi_parents[] = {
+	"pll1_d8_307p2", "pll1_d6_409p6"
+};
+static SPACEMIT_CCU_DIV_FC_MUX_GATE(axi_clk, "axi_clk", axi_parents,
+	BASE_TYPE_APMU, APMU_ACLK_CLK_CTRL,
+	1, 2, BIT(4),
+	1, 2,
+	BIT(0), BIT(0), 0x0,
+	0);
+
+/* APBC GPIO: func clock on vctcxo_24 (fixed clock from the rt24 DTSI) */
+static SPACEMIT_CCU_GATE(gpio_clk, "gpio_clk", "vctcxo_24",
+	BASE_TYPE_APBC, APBC_GPIO_CLK_RST,
+	BIT(1), BIT(1), 0x0,
+	0);
+static SPACEMIT_CCU_GATE(gpio_bus_clk, "gpio_bus_clk", "apb_clk",
+	BASE_TYPE_APBC, APBC_GPIO_CLK_RST,
+	BIT(0), BIT(0), 0x0,
+	0);
+
+/* APBC TWSI0 (I2C0): func mux + gate, bus gate on apb_clk */
+static const char * const twsi_parents[] = {
+	"pll1_d78_31p5", "pll1_d48_51p2", "pll1_d40_61p44"
+};
+static SPACEMIT_CCU_MUX_GATE(twsi0_clk, "twsi0_clk", twsi_parents,
+	BASE_TYPE_APBC, APBC_TWSI0_CLK_RST,
+	4, 3,
+	BIT(1), BIT(1), 0x0,
+	0);
+static SPACEMIT_CCU_GATE(twsi0_bus_clk, "twsi0_bus_clk", "apb_clk",
+	BASE_TYPE_APBC, APBC_TWSI0_CLK_RST,
+	BIT(0), BIT(0), 0x0,
+	0);
+
+/* APMU SDH0: AXI bus gate + func mux/div/gate (sdh01_parents minus reserved slots) */
+static SPACEMIT_CCU_GATE(sdh_axi_aclk, "sdh_axi_aclk", "axi_clk",
+	BASE_TYPE_APMU, APMU_SDH0_CLK_RES_CTRL,
+	BIT(3), BIT(3), 0x0,
+	0);
+static const char * const sdh01_parents[] = {
+	"pll1_d6_409p6", "pll1_d4_614p4", "pll2_d8", "pll2_d5",
+	"dummy_clk", "dummy_clk", "pll1_dx"
+};
+static SPACEMIT_CCU_DIV_FC_MUX_GATE(sdh0_clk, "sdh0_clk", sdh01_parents,
+	BASE_TYPE_APMU, APMU_SDH0_CLK_RES_CTRL,
+	5, 3, BIT(11),
+	8, 3,
+	BIT(4), BIT(4), 0x0,
+	0);
+
+/* APMU USB2: bus gate only (USB3 port gates are not RPMI consumers yet) */
+static SPACEMIT_CCU_GATE(usb2_bus_clk, "usb2_bus_clk", "axi_clk",
+	BASE_TYPE_APMU, APMU_USB_CLK_RES_CTRL,
+	BIT(1), BIT(1), 0x0,
+	0);
+
+/* APMU UFS: AXI func mux/div/gate + fixed /2 refclk from pll1_d64_38p4 */
+static const char * const ufs_aclk_parents[] = {
+	"pll1_d5_491p52", "pll1_d6_409p6", "pll2_d6", "pll2_d5"
+};
+static SPACEMIT_CCU_DIV_FC_MUX_GATE(ufs_aclk, "ufs_aclk", ufs_aclk_parents,
+	BASE_TYPE_APMU, APMU_UFS_CLK_RES_CTRL,
+	2, 3, BIT(1),
+	5, 3,
+	BIT(8), BIT(8), 0x0,
+	0);
+static SPACEMIT_CCU_FACTOR(ufs_refclk, "ufs_refclk", "pll1_d64_38p4", 2, 1);
+
+/* APMU EMAC0 (GMAC): bus gate, ref gate (val_disable), rgmii_tx gate */
+static SPACEMIT_CCU_GATE(emac0_bus_clk, "emac0_bus_clk", "axi_clk",
+	BASE_TYPE_APMU, APMU_EMAC0_CLK_RES_CTRL,
+	BIT(0), BIT(0), 0x0,
+	0);
+static SPACEMIT_CCU_GATE(emac0_ref_clk, "emac0_ref_clk", "pll2_d120_25",
+	BASE_TYPE_APMU, APMU_EMAC0_CLK_RES_CTRL,
+	BIT(14), 0x0, BIT(14),
+	0);
+static SPACEMIT_CCU_GATE(emac0_rgmii_tx_clk, "emac0_rgmii_tx_clk", "pll2_d24_125",
+	BASE_TYPE_APMU, APMU_EMAC0_CLK_RES_CTRL,
+	BIT(8), BIT(8), 0x0,
+	0);
+
 static struct clk_hw_onecell_data spacemit_k3_hw_clks = {
 	.num = CLK_MAX_NO,
 	.hws = {
@@ -968,6 +1078,23 @@ static struct clk_hw_onecell_data spacemit_k3_hw_clks = {
 		[CLK_RST_RCPU_PWM7]		= &rpwm7_rst.common.hw,
 		[CLK_RST_RCPU_PWM8]		= &rpwm8_rst.common.hw,
 		[CLK_RST_RCPU_PWM9]		= &rpwm9_rst.common.hw,
+		//application-core (RPMI CLOCK consumers)
+		[CLK_APB_CLK]			= &apb_clk.common.hw,
+		[CLK_AXI_CLK]			= &axi_clk.common.hw,
+		[CLK_PLL2_D6]			= &pll2_d6.common.hw,
+		[CLK_PLL2_D8]			= &pll2_d8.common.hw,
+		[CLK_GPIO_CLK]			= &gpio_clk.common.hw,
+		[CLK_GPIO_BUS_CLK]		= &gpio_bus_clk.common.hw,
+		[CLK_TWSI0_CLK]			= &twsi0_clk.common.hw,
+		[CLK_TWSI0_BUS_CLK]		= &twsi0_bus_clk.common.hw,
+		[CLK_SDH_AXI_ACLK]		= &sdh_axi_aclk.common.hw,
+		[CLK_SDH0_CLK]			= &sdh0_clk.common.hw,
+		[CLK_USB2_BUS_CLK]		= &usb2_bus_clk.common.hw,
+		[CLK_UFS_ACLK]			= &ufs_aclk.common.hw,
+		[CLK_UFS_REFCLK]		= &ufs_refclk.common.hw,
+		[CLK_EMAC0_BUS_CLK]		= &emac0_bus_clk.common.hw,
+		[CLK_EMAC0_REF_CLK]		= &emac0_ref_clk.common.hw,
+		[CLK_EMAC0_RGMII_TX_CLK]	= &emac0_rgmii_tx_clk.common.hw,
 
 		[CLK_MAX_NO]			= RT_NULL,
 	},
diff --git a/bsp/spacemit/drivers/clk/ccu-spacemit-k3.h b/bsp/spacemit/drivers/clk/ccu-spacemit-k3.h
index 48fb5f412..f928bbe91 100644
--- a/bsp/spacemit/drivers/clk/ccu-spacemit-k3.h
+++ b/bsp/spacemit/drivers/clk/ccu-spacemit-k3.h
@@ -66,6 +66,23 @@
 /* APMU register offset */
 #define APMU_RCPU_CLK_RES_CTRL		0x14c
 
+/*
+ * Application-core clock/reset-control registers. Offsets and bit layouts
+ * mirror Linux include/soc/spacemit/k3-syscon.h and drivers/clk/spacemit/
+ * ccu-k3.c: the RPMI clock service (k3-rpmi-clk-ids.h) resolves these
+ * clocks by name for Linux consumers, so enable/reset semantics must
+ * match the Linux CCU driver exactly.
+ */
+#define APMU_ACLK_CLK_CTRL		0x388
+#define APMU_SDH0_CLK_RES_CTRL		0x054
+#define APMU_USB_CLK_RES_CTRL		0x05c
+#define APMU_UFS_CLK_RES_CTRL		0x268
+#define APMU_EMAC0_CLK_RES_CTRL		0x3e4
+
+/* APBC register offsets (application-core peripheral clock domain) */
+#define APBC_GPIO_CLK_RST		0x08
+#define APBC_TWSI0_CLK_RST		0x2c
+
 /* RCPU SYSCTRL register offsets */
 #define RCPU_CAN_CLK_RST		0x4c
 #define RCPU_CAN1_CLK_RST		0xF0
diff --git a/bsp/spacemit/platform/rt24/ccu-spacemit-k3.h b/bsp/spacemit/platform/rt24/ccu-spacemit-k3.h
index 9d3f8e581..8a79d007f 100644
--- a/bsp/spacemit/platform/rt24/ccu-spacemit-k3.h
+++ b/bsp/spacemit/platform/rt24/ccu-spacemit-k3.h
@@ -169,6 +169,27 @@
 #define CLK_RST_RCPU_PWM7        159
 #define CLK_RST_RCPU_PWM8        160
 #define CLK_RST_RCPU_PWM9        161
-#define CLK_MAX_NO               162
 
+/*
+ * Application-core clock IDs (append-only: never renumber or reuse).
+ * These feed the RPMI CLOCK service via k3-rpmi-clk-ids.h name lookup;
+ * values 162+ continue the existing ID space.
+ */
+#define CLK_APB_CLK              162
+#define CLK_AXI_CLK              163
+#define CLK_PLL2_D6              164
+#define CLK_PLL2_D8              165
+#define CLK_GPIO_CLK             166
+#define CLK_GPIO_BUS_CLK         167
+#define CLK_TWSI0_CLK            168
+#define CLK_TWSI0_BUS_CLK        169
+#define CLK_SDH_AXI_ACLK         170
+#define CLK_SDH0_CLK             171
+#define CLK_USB2_BUS_CLK         172
+#define CLK_UFS_ACLK             173
+#define CLK_UFS_REFCLK           174
+#define CLK_EMAC0_BUS_CLK        175
+#define CLK_EMAC0_REF_CLK        176
+#define CLK_EMAC0_RGMII_TX_CLK   177
+#define CLK_MAX_NO               178
 #endif /* _CCU_SPACEMIT_K3_DTS_H_ */
diff --git a/components/drivers/include/drivers/clk-provider.h b/components/drivers/include/drivers/clk-provider.h
index 316601c9b..d611cd592 100644
--- a/components/drivers/include/drivers/clk-provider.h
+++ b/components/drivers/include/drivers/clk-provider.h
@@ -43,7 +43,11 @@ struct clk_onecell_data {
 struct clk_hw_onecell_data {
 	rt_uint32_t num;
 #if defined(SOC_SPACEMIT_K3)
-	struct clk_hw *hws[168];
+	/* Sized for the K3 CCU table including application-core clocks
+	 * (see CLK_MAX_NO in bsp/spacemit/platform/rt24/ccu-spacemit-k3.h,
+	 * included relatively by ccu-spacemit-k3.c); keep in sync when
+	 * appending clock IDs. */
+	struct clk_hw *hws[192];
 #elif defined(SOC_SPACEMIT_K1_X)
 	struct clk_hw *hws[128];
 #else
-- 
2.56.1

