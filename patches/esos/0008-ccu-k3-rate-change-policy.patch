diff --git a/bsp/spacemit/drivers/rpmi/k3/k3-os0_clk.c b/bsp/spacemit/drivers/rpmi/k3/k3-os0_clk.c
index cb4821b66..ff9995913 100644
--- a/bsp/spacemit/drivers/rpmi/k3/k3-os0_clk.c
+++ b/bsp/spacemit/drivers/rpmi/k3/k3-os0_clk.c
@@ -37,6 +37,47 @@ struct k3_rpmi_clk_entry {
 
 static struct k3_rpmi_clk_entry k3_rpmi_clks[K3_RPMI_CLK_COUNT];
 
+/*
+ * ---- per-clock rate-change policy (P1: runtime clock ownership) ---
+ *
+ * A local set_rate capability is NECESSARY but NOT SUFFICIENT.
+ * Rules, in evaluation order:
+ *   IDMPOTENT STATE  enable-when-enabled / disable-when-disabled
+ *                    are SUCCESS, not RPMI_ERR_ALREADY (the
+ *                    ufs_refclk finding: firmware leaves consumer
+ *                    clocks on; the first Linux enable must not
+ *                    fail on that)
+ *   RATE ALLOWLIST   only explicitly allowlisted clocks may change
+ *                    rates; consumer clocks start LOCKED (their
+ *                    rates are qualified firmware constants)
+ *   SHARED PARENT    an allowlisted clock's set_rate is refused
+ *                    while any other published clock on the same
+ *                    CCU parent is enabled
+ *   BOOT SNAPSHOT    the service init records the firmware-enabled
+ *                    set; those clocks' first Linux enable is
+ *                    recognized as idempotent
+ */
+enum k3_clk_rate_policy {
+	K3_CLK_RATE_LOCKED = 0,
+	K3_CLK_RATE_ALLOWED,
+};
+
+struct k3_clk_policy_entry {
+	enum k3_clk_rate_policy	rate_policy;
+	rt_bool_t		boot_enabled;
+};
+
+static struct k3_clk_policy_entry k3_clk_policies[K3_RPMI_CLK_COUNT];
+
+/* Rate changes are denied until a clock is explicitly qualified here. */
+static const enum k3_clk_rate_policy k3_clk_rate_allowlist[K3_RPMI_CLK_COUNT] = {
+	[K3_RPMI_CLK_RPROC]		= K3_CLK_RATE_ALLOWED,
+	/* every consumer clock starts LOCKED: ufs_aclk (the sys1clk
+	 * truth), ufs_refclk, sdh, emac, gpio, twsi — their rates are
+	 * qualified firmware constants until a specific rate need is
+	 * proven */
+};
+
 /* placeholder rate for clocks not yet present in the CCU table */
 static rpmi_uint64_t k3_rpmi_unresolved_rate;
 
@@ -161,9 +202,61 @@ static rt_int32_t _k3_os0_clock_init(void *priv)
 		}
 	}
 
+	/*
+	 * BOOT SNAPSHOT: record the firmware-enabled set so the first
+	 * Linux enable of a boot-enabled clock is idempotent-success.
+	 */
+	for (i = 0; i < K3_RPMI_CLK_COUNT; i++) {
+		struct clk *c = k3_rpmi_clk_resolve(i);
+
+		k3_clk_policies[i].rate_policy = k3_clk_rate_allowlist[i];
+		k3_clk_policies[i].boot_enabled =
+			(c && spacemit_ccu_clk_is_enabled(c)) ? RT_TRUE : RT_FALSE;
+	}
+
 	return 0;
 }
 
+/*
+ * POLICY (shared parent): TRUE when any OTHER published clock
+ * sharing clock_id's CCU parent is currently enabled.
+ */
+static rt_bool_t k3_rpmi_clk_shared_parent_busy(rpmi_uint32_t clock_id,
+						rpmi_uint32_t except_id)
+{
+	struct clk *clk = k3_rpmi_clk_resolve(clock_id);
+	struct clk *parent;
+	rpmi_uint32_t i;
+
+	if (!clk)
+		return RT_FALSE;
+
+	parent = clk_hw_get_parent_by_index(__clk_get_hw(clk), 0) ?
+		 clk_hw_get_parent_by_index(__clk_get_hw(clk), 0)->clk :
+		 RT_NULL;
+	if (!parent)
+		return RT_FALSE;	/* root clock: no shared parent */
+
+	for (i = 0; i < K3_RPMI_CLK_COUNT; i++) {
+		struct clk_hw *hw;
+		struct clk *c;
+
+		if (i == except_id || i == K3_RPMI_CLK_RPROC)
+			continue;
+		c = k3_rpmi_clk_resolve(i);
+		if (!c || c == clk)
+			continue;
+		hw = __clk_get_hw(c);
+		if (!hw)
+			continue;
+		if (clk_hw_get_parent_by_index(hw, 0) &&
+		    clk_hw_get_parent_by_index(hw, 0)->clk == parent &&
+		    spacemit_ccu_clk_is_enabled(c))
+			return RT_TRUE;
+	}
+	return RT_FALSE;
+}
+
 static enum rpmi_error spacemit_set_state(void *priv, rpmi_uint32_t clock_id,
                                           enum rpmi_clock_state state)
 {
@@ -179,9 +272,17 @@ static enum rpmi_error spacemit_set_state(void *priv, rpmi_uint32_t clock_id,
 		return RPMI_ERR_NOTSUPP;
 
 	if (state == RPMI_CLK_STATE_ENABLED) {
+		/* POLICY (idempotent enable): enabling a clock that is
+		 * already running — including the firmware-boot-enabled
+		 * set — is SUCCESS (the ufs_refclk -EALREADY finding) */
+		if (spacemit_ccu_clk_is_enabled(clk))
+			return RPMI_SUCCESS;
 		if (clk_prepare_enable(clk))
 			return RPMI_ERR_FAILED;
 	} else if (state == RPMI_CLK_STATE_DISABLED) {
+		/* POLICY (idempotent disable): symmetric */
+		if (!spacemit_ccu_clk_is_enabled(clk))
+			return RPMI_SUCCESS;
 		clk_disable_unprepare(clk);
 	} else {
 		return RPMI_ERR_INVALID_PARAM;
@@ -293,6 +394,16 @@ static enum rpmi_error spacemit_set_rate(void *priv, rpmi_uint32_t clock_id,
 	if (!clk_has_local_set_rate(clk))
 		return RPMI_ERR_NOTSUPP;
 
+	/* POLICY (allowlist): capability is necessary but not
+	 * sufficient; only explicitly qualified clocks change rates */
+	if (k3_clk_policies[clock_id].rate_policy != K3_CLK_RATE_ALLOWED)
+		return RPMI_ERR_DENIED;
+
+	/* POLICY (shared parent): refuse while any sibling published
+	 * clock on the same CCU parent is enabled */
+	if (k3_rpmi_clk_shared_parent_busy(clock_id, clock_id))
+		return RPMI_ERR_DENIED;
+
 	if (clk_set_rate(clk, (rt_uint64_t)rate))
 		return RPMI_ERR_DENIED;
 
