+/*
+ * ---- device-power ownership gate (P2 #1) ---------------------------
+ *
+ * The RPMI DEVICE_POWER group exposes register-block power
+ * transitions to the AP. A transition is ELIGIBLE only when the
+ * device's owning consumer class holds no active consumers — the
+ * same contract the P1 cluster-sleep gate enforces
+ * (k3-os0_hsm.c), applied at device granularity:
+ *
+ *   REGISTERED+QUIESCENT  transition proceeds
+ *   REGISTERED+ACTIVE     RPMI_ERR_DENIED (the AP cannot yank
+ *                         power under a live consumer)
+ *   UNREGISTERED          RPMI_ERR_DENIED (unknown ownership
+ *                         blocks, never allows — P1 audit rule)
+ *
+ * Domain->consumer-class map mirrors the dtb children (vpu, gpu,
+ * audio, lcd0, lcd1, dummy). gpu->GPU, lcd0/lcd1->DISPLAY.
+ * vpu/audio/dummy are deliberately UNMAPPED: like the vendor's
+ * AUDIO carve-out (RCPU-managed), their power is not
+ * AP-controllable on this board until a qualification says so.
+ */
+static const enum k3_consumer_class k3_pmdomain_owner_map[] = {
+	[0]	= K3_CONSUMER_UNKNOWN,	/* vpu    */
+	[1]	= K3_CONSUMER_GPU,	/* gpu    */
+	[2]	= K3_CONSUMER_UNKNOWN,	/* audio  */
+	[3]	= K3_CONSUMER_DISPLAY,	/* lcd0   */
+	[4]	= K3_CONSUMER_DISPLAY,	/* lcd1   */
+	[5]	= K3_CONSUMER_UNKNOWN,	/* dummy  */
+};
+
+static enum rpmi_error k3_pmdomain_gate(rpmi_uint32_t domain_id)
+{
+	if (domain_id >= sizeof(k3_pmdomain_owner_map) / sizeof(k3_pmdomain_owner_map[0]))
+		return RPMI_ERR_DENIED;
+
+	if (!k3_device_power_eligible(k3_pmdomain_owner_map[domain_id]))
+		return RPMI_ERR_DENIED;
+
+	return RPMI_SUCCESS;
+}
