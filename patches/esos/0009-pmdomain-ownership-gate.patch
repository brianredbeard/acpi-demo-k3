+/* ---- device-power ownership (P2 #1) ---------------------------------
+ *
+ * The cluster model guards shared-cluster sleep; device domains
+ * (RPMI DEVICE_POWER group: vpu/gpu/audio/lcd0/lcd1) need the same
+ * contract at device granularity: a device's power may transition
+ * only when no consumer class holds it. Same rules as P1:
+ *   unregistered device      -> ineligible (unknown blocks)
+ *   registered + any holder  -> ineligible
+ *   registered + quiescent   -> eligible
+ * The registry is per CONSUMER CLASS (the device domains each have
+ * exactly one natural owner class; multi-owner devices would need
+ * the full refcount array — none exist on this board).
+ */
+static rt_uint16_t k3_device_power_consumers[K3_CONSUMER_CLASS_COUNT];
+static rt_uint8_t k3_device_power_registered[K3_CONSUMER_CLASS_COUNT];
+
+int k3_device_power_register(enum k3_consumer_class owner)
+{
+	if ((owner >= K3_CONSUMER_CLASS_COUNT) || (owner == K3_CONSUMER_UNKNOWN))
+		return -RT_EINVAL;
+
+	rt_base_t level = rt_hw_interrupt_disable();
+	k3_device_power_registered[owner] = 1;
+	k3_device_power_consumers[owner] = 0;
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+int k3_device_power_consumer_acquire(enum k3_consumer_class c)
+{
+	if ((c >= K3_CONSUMER_CLASS_COUNT) || (c == K3_CONSUMER_UNKNOWN))
+		return -RT_EINVAL;
+
+	rt_base_t level = rt_hw_interrupt_disable();
+	k3_device_power_consumers[c]++;
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+int k3_device_power_consumer_release(enum k3_consumer_class c)
+{
+	if ((c >= K3_CONSUMER_CLASS_COUNT) || (c == K3_CONSUMER_UNKNOWN))
+		return -RT_EINVAL;
+
+	rt_base_t level = rt_hw_interrupt_disable();
+	if (k3_device_power_consumers[c])
+		k3_device_power_consumers[c]--;
+	rt_hw_interrupt_enable(level);
+	return 0;
+}
+
+rt_bool_t k3_device_power_eligible(enum k3_consumer_class owner)
+{
+	if ((owner >= K3_CONSUMER_CLASS_COUNT) || (owner == K3_CONSUMER_UNKNOWN))
+		return RT_FALSE;
+
+	rt_base_t level = rt_hw_interrupt_disable();
+	rt_bool_t eligible = k3_device_power_registered[owner] &&
+			     (k3_device_power_consumers[owner] == 0);
+	rt_hw_interrupt_enable(level);
+	return eligible;
+}
