+static int enable(struct pinctrl_dev *p,unsigned f,unsigned g) { (void)p;(void)g;writes++;if(enable_error)return enable_error;mux=f;return 0; }
+static int pinconf_apply_setting(const struct pinctrl_setting *s) { (void)s;return config_error; }
