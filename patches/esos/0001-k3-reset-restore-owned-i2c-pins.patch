+
+reset_fixture = r'''
+typedef uint32_t rpmi_uint32_t;
+typedef uint8_t rpmi_uint8_t;
+typedef int rt_size_t;
+#define RT_I2C_WR 0
+#define RT_I2C_RD 1
+#define PIN_MODE_OUTPUT 1
+#define PIN_LOW 0
+#define RPMI_SYSRST_TYPE_SHUTDOWN 0
+#define RPMI_SYSRST_TYPE_COLD_REBOOT 1
+#define RPMI_SYSRST_TYPE_WARM_REBOOT 2
+struct rt_i2c_bus_device { int unused; };
+struct rt_i2c_msg { unsigned addr,flags,len; unsigned char *buf; };
+struct spacemit_rpmi_sysreset_config { int reset; };
+static struct rt_i2c_bus_device bus;
+static struct rt_i2c_bus_device *i2c_bus_device=&bus;
+static rt_uint32_t i2c_addr=0x41;
+static unsigned char boot_flag;
+#define LISTEN_ADDR ((uintptr_t)&boot_flag)
+static char events[64];static int count,depth,restore_error,lock_error,read_error,flag_error,write_error;
+static unsigned written_flag,reset_bits;
+static jmp_buf shutdown_jump;
+static void event(char c) {events[count++]=c;events[count]=0;}
+static int rt_i2c_bus_lock(struct rt_i2c_bus_device *b,int ticks) {
+ require(b==&bus && ticks==RT_WAITING_FOREVER,"preserve transfer lock policy rather than impose a shorter reset deadline");event('L');if(lock_error)return lock_error;depth++;return 0;
+}
+static int rt_i2c_bus_unlock(struct rt_i2c_bus_device *b) {require(b==&bus && depth==1,"balanced outer bus lock");depth--;event('U');return 0;}
+static int spacemit_i2c_restore_pins(struct rt_i2c_bus_device *b) {require(b==&bus && depth==1,"restore must run under bus lock");event('P');return restore_error;}
+static rt_size_t rt_i2c_transfer(struct rt_i2c_bus_device *b,struct rt_i2c_msg *m,unsigned n) {
