+#!/usr/bin/env python3
+"""Host regressions for actual ESOS C; hardware/RTOS boundaries are simulated.
+
+The baseline uses its ordinary state selection and unmodified reset handler.
+Regressions catch skipped hardware restore, leaked ownership, writes after
+validation failures, and PMIC traffic outside the terminal bus transaction.
+"""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = Path(sys.argv[1]) if len(sys.argv) > 1 else (
+    root if (root/'components/drivers/pinctrl/core.c').exists()
+    else root/'esos-reset-handoff')
+
+
+def function(text, name):
+    import re
+    m = re.search(r'(?m)^(?:static )?(?:inline )?(?:int|void|rt_err_t)\s+' + name + r'\(', text)
+    if not m:
+        raise ValueError(name)
+    opening = text.index('{', m.start())
+    depth, end = 1, opening + 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[m.start():end]
+
+
+common = r'''
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <setjmp.h>
+#define RT_EINVAL 10
+#define RT_EBUSY 7
+#define RT_ERROR 1
+#define RT_ENOSYS 6
+#define RT_ETIMEOUT 2
+#define RT_TICK_PER_SECOND 100
+#define RT_WAITING_FOREVER -1
+#define RT_NULL NULL
+#define RT_EOK 0
+#define rt_strcmp strcmp
+#define rt_kprintf(...) ((void)0)
+#define IS_ERR(x) ((uintptr_t)(x) > (uintptr_t)-1000)
+#define PTR_ERR(x) ((intptr_t)(x))
+typedef uint32_t rt_uint32_t;
+typedef uint8_t rt_uint8_t;
+typedef int rt_err_t;
+typedef void *rt_thread_t;
+static void require(bool ok, const char *why) {
+ if (!ok) { fprintf(stderr, "FAIL: %s\n", why); exit(1); }
+}
+'''
+
+pinctrl_fixture = r'''
+#define PIN_MAP_TYPE_MUX_GROUP 1
+#define PIN_MAP_TYPE_CONFIGS_PIN 2
+#define PIN_MAP_TYPE_CONFIGS_GROUP 3
+struct dtb_node { const char *name; };
