+/* Restore an existing selection after an external owner changed hardware.
+ * Caller must serialize local state changes and quiesce external users.
+ * No ownership is acquired/released. A hardware error may leave a partially
+ * restored state; report it rather than claiming rollback to external state.
+ */
+int pinctrl_reapply_state(struct dtb_node *node, const char *name)
+{
+	struct pinctrl *p;
+	struct pinctrl_state *state;
+	struct pinctrl_setting *setting;
+	int ret;
+
+	if (!node || !name)
+		return -RT_EINVAL;
+	p = find_pinctrl(node);
+	if (!p)
+		return -RT_EINVAL;
+	state = pinctrl_lookup_state(p, name);
+	if (IS_ERR(state))
+		return PTR_ERR(state);
+	if (!state || p->state != state)
+		return -RT_EINVAL;
+
+	/* Validate every mux group before writing any of them. */
+	rt_list_for_each_entry(setting, &state->settings, node) {
+		switch (setting->type) {
+		case PIN_MAP_TYPE_MUX_GROUP:
+			ret = pinmux_check_active_setting(setting);
+			if (ret)
+				return ret;
+			break;
+		case PIN_MAP_TYPE_CONFIGS_PIN:
+		case PIN_MAP_TYPE_CONFIGS_GROUP:
+			break;
+		default:
+			return -RT_EINVAL;
+		}
+	}
+
+	rt_list_for_each_entry(setting, &state->settings, node) {
+		if (setting->type == PIN_MAP_TYPE_MUX_GROUP)
+			ret = pinmux_reapply_setting(setting);
+		else
+			ret = pinconf_apply_setting(setting);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
