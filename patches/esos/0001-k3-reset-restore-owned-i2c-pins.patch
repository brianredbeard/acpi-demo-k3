+struct pinctrl_dev;
+struct pinmux_ops { int (*enable)(struct pinctrl_dev*, unsigned, unsigned); };
+struct pinctrl_ops { int (*get_group_pins)(struct pinctrl_dev*, unsigned, const unsigned**, unsigned*); };
+struct pinctrl_desc { const struct pinmux_ops *pmxops; const struct pinctrl_ops *pctlops; };
+struct pinctrl_dev { struct pinctrl_desc *desc; };
+struct pinctrl_setting {
+ int type, node;
+ struct pinctrl_setting *next;
+ struct pinctrl_dev *pctldev;
+ const char *dev_name;
+ union { struct pinctrl_setting_mux mux; } data;
+};
+struct settings_list { struct pinctrl_setting *first; };
+struct pinctrl_state { struct settings_list settings; };
+struct pinctrl { struct pinctrl_state *state; };
+struct pin_desc { unsigned mux_usecount; const char *mux_owner; const struct pinctrl_setting_mux *mux_setting; const char *gpio_owner; };
+#define rt_list_for_each_entry(pos,head,member) for ((pos)=(head)->first;(pos);(pos)=(pos)->next)
+static struct pin_desc pins[2];
+static unsigned pin_ids[2]={0,1};
+static int mux, writes, group_error, enable_error, config_error;
+static bool missing_handle, missing_state;
+static struct pinctrl cached;
+static struct pinctrl_state selected;
+static struct pinctrl *find_pinctrl(struct dtb_node *n) { (void)n; return missing_handle ? NULL : &cached; }
